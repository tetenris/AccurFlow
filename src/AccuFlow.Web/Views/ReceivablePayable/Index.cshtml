@{
    ViewData["Title"] = "Receivable & Payable";
}

<div class="card">
    <div class="card-body">
        <div class="row mb-5">
            <div class="col-md-3">
                <label>Report Type</label>
                <select class="form-select" id="report-type">
                    <option value="AR">Receivable (AR)</option>
                    <option value="AP">Payable (AP)</option>
                </select>
            </div>
            <div class="col-md-3">
                <label>As Of Date</label>
                <input type="date" class="form-control" id="as-of-date" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button class="btn btn-primary" id="btn-generate">Generate</button>
            </div>
        </div>
        <div class="table-responsive">
            <table id="receivable_payable_datatable" class="table table-striped table-row-bordered gy-5 gs-7 border rounded w-100">
                <thead>
                    <tr>
                        <th>Partner Code</th>
                        <th>Partner Name</th>
                        <th>Invoice No</th>
                        <th>Invoice Date</th>
                        <th>Due Date</th>
                        <th>Total</th>
                        <th>Paid</th>
                        <th>Outstanding</th>
                        <th>Status</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/custom/features/receivablepayable/index.js"></script>
}