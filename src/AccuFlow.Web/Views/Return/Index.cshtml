@{
    ViewData["Title"] = "Sales & Purchase Returns";
}

<div class="card">
    <div class="card-body">
        <div class="row mb-5">
            <div class="col-md-3">
                <label>Return Type</label>
                <select class="form-select" id="filter-type">
                    <option value="">All Types</option>
                    <option value="Sales">Sales Return</option>
                    <option value="Purchase">Purchase Return</option>
                </select>
            </div>
            <div class="col-md-3">
                <label>Status</label>
                <select class="form-select" id="filter-status">
                    <option value="">All Status</option>
                    <option value="Draft">Draft</option>
                    <option value="Posted">Posted</option>
                </select>
            </div>
            <div class="col-md-6 d-flex align-items-end justify-content-end gap-2 ms-auto">
                <button class="btn btn-primary" id="btn-apply-filter">Apply Filter</button>
                <button class="btn btn-success" id="btn-add-return">Add Return</button>
            </div>
        </div>
        <div class="table-responsive">
            <table id="return_datatable" class="table table-striped table-row-bordered gy-5 gs-7 border rounded w-100">
                <thead>
                    <tr>
                        <th>No</th>
                        <th>Return No</th>
                        <th>Type</th>
                        <th>Date</th>
                        <th>Invoice</th>
                        <th>Partner</th>
                        <th>Status</th>
                        <th>Lines</th>
                        <th>Total</th>
                        <th>Action</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="return_modal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Goods Return</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-4 mb-5">
                    <div class="col-md-3">
                        <label>Return Type</label>
                        <select class="form-select" id="return-type">
                            <option value="Sales">Sales Return</option>
                            <option value="Purchase">Purchase Return</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label>Return Date</label>
                        <input type="date" class="form-control" id="return-date" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-3">
                        <label>Invoice</label>
                        <select class="form-select" id="return-invoice-id"></select>
                    </div>
                    <div class="col-md-3">
                        <label>Warehouse</label>
                        <select class="form-select" id="return-warehouse-id"></select>
                    </div>
                    <div class="col-md-12">
                        <label>Notes</label>
                        <input type="text" class="form-control" id="return-notes" />
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-row-bordered align-middle">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th>Description</th>
                                <th class="text-end">Invoice Qty</th>
                                <th class="text-end">Remaining</th>
                                <th class="text-end">Return Qty</th>
                                <th class="text-end">Unit Price</th>
                                <th class="text-end">Tax</th>
                                <th class="text-end">Line Total</th>
                            </tr>
                        </thead>
                        <tbody id="return-items-body">
                            <tr id="return-items-empty"><td colspan="8" class="text-center text-muted py-5">Select an invoice to load lines</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btn-save-return">Save</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="return_detail_modal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Return Detail</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="return-detail-content"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/custom/features/return/index.js"></script>
}