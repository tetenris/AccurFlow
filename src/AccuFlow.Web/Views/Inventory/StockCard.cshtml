@{
    ViewData["Title"] = "Stock Card";
}

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="stock_card_datatable" class="table table-striped table-row-bordered gy-5 gs-7 border rounded w-100">
                <thead>
                    <tr>
                        <th>No</th>
                        <th>Date</th>
                        <th>Item</th>
                        <th>Warehouse</th>
                        <th>Type</th>
                        <th>In</th>
                        <th>Out</th>
                        <th>Unit Cost</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/custom/features/inventory/stock-card.js"></script>
}
