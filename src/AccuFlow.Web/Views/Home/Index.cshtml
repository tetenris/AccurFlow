@model AccuFlow.Models.Home.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Breadcrumbs"] = new List<AccuFlow.Helpers.BreadcrumbHelper.BreadcrumbItem>
    {
        new AccuFlow.Helpers.BreadcrumbHelper.BreadcrumbItem { Title = "Home", Url = "/" },
        new AccuFlow.Helpers.BreadcrumbHelper.BreadcrumbItem { Title = "Dashboard", Url = "#" }
    };

    string Currency(decimal value) => string.Format(new System.Globalization.CultureInfo("id-ID"), "Rp {0:N0}", value);
    var completionRate = Model.DraftJournals + Model.PostedJournals == 0
        ? 0
        : (int)Math.Round((decimal)Model.PostedJournals / (Model.DraftJournals + Model.PostedJournals) * 100);
}

<style>
    .dashboard-canvas {
        --dash-primary: #3E97FF;
        --dash-primary-dark: #0B5CAD;
        --dash-primary-light: #f1faff;
        --dash-ink: #1B263B;
        --dash-muted: #64748B;
        --dash-line: #E4E9F2;
        --dash-bg-soft: #F6F8FB;
        display: flex;
        flex-direction: column;
        gap: 20px;
        color: var(--dash-ink);
    }

    .dashboard-hero {
        position: relative;
        overflow: hidden;
        display: grid;
        grid-template-columns: minmax(0, 1.4fr) minmax(280px, 0.6fr);
        gap: 20px;
    }

    .dashboard-hero::after {
        content: "";
        position: absolute;
        right: -70px;
        top: -90px;
        width: 260px;
        height: 260px;
        border-radius: 999px;
        background: radial-gradient(circle, rgba(255, 255, 255, 0.25), transparent 68%);
    }

    .hero-panel {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 240px;
        padding: clamp(24px, 3vw, 32px);
        border-radius: 12px;
        background: var(--dash-primary);
        color: #fff;
    }

    .hero-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        align-self: flex-start;
        padding: 7px 12px;
        margin-bottom: 20px;
        border: 1px solid rgba(255, 255, 255, 0.25);
        border-radius: 6px;
        color: rgba(255, 255, 255, 0.88);
        background: rgba(255, 255, 255, 0.1);
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .hero-eyebrow i {
        display: grid;
        place-items: center;
        width: 20px;
        height: 20px;
        border-radius: 5px;
        color: #fff;
        background: #ff4d4f;
        font-size: 11px;
    }

    .hero-title {
        max-width: 760px;
        margin: 0;
        font-size: clamp(28px, 3.4vw, 44px);
        line-height: 1.05;
        letter-spacing: -0.03em;
        font-weight: 800;
    }

    .hero-copy {
        max-width: 640px;
        margin: 14px 0 0;
        color: rgba(255, 255, 255, 0.82);
        font-size: 14px;
        line-height: 1.7;
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 22px;
    }

    .dash-button {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px;
        border-radius: 8px;
        font-weight: 800;
        font-size: 13px;
        text-decoration: none;
        transition: background 180ms ease, color 180ms ease;
    }

    .dash-button i {
        display: grid;
        place-items: center;
        width: 22px;
        height: 22px;
        border-radius: 5px;
        font-size: 13px;
        line-height: 1;
        color: #fff;
        background: #ff4d4f;
    }

    .dash-button.primary {
        color: var(--dash-primary);
        background: #00FFFF;
    }

    .dash-button.primary:hover {
        color: var(--dash-primary-dark);
        background: #00e6e6;
    }

    .dash-button.soft {
        color: #17312f;
        border: 1px solid #00FFFF;
        background: #00FFFF;
    }

    .dash-button.soft:hover {
        color: var(--dash-primary);
        background: #00e6e6;
        border-color: #00e6e6;
    }

    .hero-score {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 240px;
        padding: 24px;
        border: 1px solid var(--dash-line);
        border-radius: 12px;
        background: #fff;
    }

    .score-ring {
        --score: 0deg;
        display: grid;
        place-items: center;
        width: 120px;
        height: 120px;
        margin-left: auto;
        border-radius: 50%;
        background: conic-gradient(var(--dash-primary) var(--score), var(--dash-primary-light) 0);
    }

    .score-ring span {
        display: grid;
        place-items: center;
        width: 92px;
        height: 92px;
        border-radius: 50%;
        background: #fff;
        font-size: 24px;
        font-weight: 800;
    }

    .metric-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
    }

    .metric-card {
        position: relative;
        overflow: hidden;
        padding: 20px;
        border: 1px solid var(--dash-line);
        border-radius: 12px;
        background: #fff;
    }

    .metric-card::after {
        content: "";
        position: absolute;
        right: -38px;
        bottom: -48px;
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background: rgba(217, 154, 43, 0.14);
    }

    .metric-icon {
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        margin-bottom: 16px;
        border-radius: 8px;
        color: #fff;
        background: #3E97FF;
    }

    .metric-icon i {
        color: #fff;
        font-size: 18px;
    }

    .metric-value {
        position: relative;
        z-index: 1;
        margin: 0;
        font-size: 22px;
        font-weight: 800;
        letter-spacing: -0.03em;
    }

    .metric-label {
        position: relative;
        z-index: 1;
        margin: 6px 0 0;
        color: var(--dash-muted);
        font-size: 13px;
        font-weight: 700;
    }

    .dashboard-main-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.9fr);
        gap: 20px;
    }

    .dash-panel {
        padding: 24px;
        border: 1px solid var(--dash-line);
        border-radius: 12px;
        background: #fff;
    }

    .panel-header {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 18px;
    }

    .panel-header h3 {
        margin: 0;
        font-size: 18px;
        font-weight: 800;
    }

    .quick-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    .quick-tile {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 16px;
        min-height: 108px;
        border: 1px solid var(--dash-line);
        border-radius: 10px;
        color: var(--dash-ink);
        background: var(--dash-bg-soft);
        text-decoration: none;
        transition: border-color 180ms ease, background 180ms ease;
    }

    .quick-tile:hover {
        color: var(--dash-ink);
        border-color: var(--dash-primary);
        background: var(--dash-primary-light);
    }

    .quick-tile i {
        display: grid;
        place-items: center;
        flex: 0 0 42px;
        height: 42px;
        border-radius: 12px;
        color: #fff;
        font-size: 18px;
        background: #4ade80;
    }

    .quick-tile strong {
        display: block;
        margin-bottom: 4px;
        font-weight: 800;
    }

    .quick-tile span {
        color: var(--dash-muted);
        font-size: 12px;
        line-height: 1.5;
    }

    .activity-list {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .activity-item {
        display: grid;
        grid-template-columns: 40px minmax(0, 1fr);
        gap: 14px;
        align-items: start;
        padding-bottom: 14px;
        border-bottom: 1px solid var(--dash-line);
    }

    .activity-item:last-child {
        border-bottom: 0;
        padding-bottom: 0;
    }

    .activity-badge {
        display: grid;
        place-items: center;
        width: 42px;
        height: 42px;
        border-radius: 12px;
        color: #fff;
        background: #d99a2b;
        font-weight: 900;
    }

    .activity-item strong {
        display: block;
        font-weight: 900;
    }

    .activity-item p {
        margin: 4px 0;
        color: var(--dash-muted);
        font-size: 12px;
    }

    .activity-item small {
        color: var(--dash-muted);
        font-weight: 700;
    }

    @@media (max-width: 1200px) {
        .metric-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 992px) {
        .dashboard-hero,
        .dashboard-main-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 640px) {
        .metric-grid,
        .quick-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="dashboard-canvas">
    <section class="dashboard-hero">
        <div class="hero-panel">
            <div class="hero-eyebrow"><i class="ki-outline ki-chart-line"></i> Finance command center</div>
            <h1 class="hero-title">Selamat datang, @Model.FullName</h1>
            <p class="hero-copy">
                Pantau arus invoice, jurnal, kas, dan aktivitas operasional dari satu dashboard yang lebih jelas.
                Anda login sebagai <strong>@Model.RoleName</strong>.
            </p>
            <div class="hero-actions">
                <a class="dash-button primary" href="@Url.Action("Index", "JournalEntry")"><i class="ki-outline ki-plus-square"></i> New Journal</a>
                <a class="dash-button soft" href="@Url.Action("Index", "Invoice")"><i class="ki-outline ki-document"></i> Open Invoices</a>
                <a class="dash-button soft" href="@Url.Action("Index", "GeneralLedger")"><i class="ki-outline ki-book"></i> Ledger</a>
            </div>
        </div>
        <aside class="hero-score">
            <div>
                <div class="text-muted fw-bold mb-2">Journal posting health</div>
                <div class="score-ring" style="--score:@(completionRate * 3.6)deg"><span>@completionRate%</span></div>
            </div>
            <div class="mt-4">
                <div class="fw-bold">@Model.PostedJournals posted / @Model.DraftJournals draft</div>
                <div class="text-muted fs-7">Keep draft journals reviewed and posted.</div>
            </div>
        </aside>
    </section>

    <section class="metric-grid">
        <article class="metric-card">
            <div class="metric-icon"><i class="ki-outline ki-wallet"></i></div>
            <h2 class="metric-value">@Currency(Model.Receivables)</h2>
            <p class="metric-label">Outstanding receivables</p>
        </article>
        <article class="metric-card">
            <div class="metric-icon"><i class="ki-outline ki-bank"></i></div>
            <h2 class="metric-value">@Currency(Model.Payables)</h2>
            <p class="metric-label">Outstanding payables</p>
        </article>
        <article class="metric-card">
            <div class="metric-icon"><i class="ki-outline ki-calendar-tick"></i></div>
            <h2 class="metric-value">@Model.OverdueInvoices</h2>
            <p class="metric-label">Overdue invoices from @Model.OpenInvoices open</p>
        </article>
        <article class="metric-card">
            <div class="metric-icon"><i class="ki-outline ki-dollar"></i></div>
            <h2 class="metric-value">@Currency(Model.CashMovementsThisMonth)</h2>
            <p class="metric-label">Cash movement this month</p>
        </article>
    </section>

    <section class="dashboard-main-grid">
        <div class="dash-panel">
            <div class="panel-header">
                <div>
                    <h3>Quick Actions</h3>
                    <div class="text-muted fs-7">Shortcut untuk pekerjaan harian.</div>
                </div>
            </div>
            <div class="quick-grid">
                <a class="quick-tile" href="@Url.Action("Index", "ChartOfAccount")">
                    <i class="ki-outline ki-folder"></i>
                    <div><strong>Chart of Accounts</strong><span>Kelola struktur akun dan akun posting.</span></div>
                </a>
                <a class="quick-tile" href="@Url.Action("Index", "Invoice")">
                    <i class="ki-outline ki-document"></i>
                    <div><strong>Invoices</strong><span>Buat dan pantau invoice penjualan maupun pembelian.</span></div>
                </a>
                <a class="quick-tile" href="@Url.Action("Index", "Payment")">
                    <i class="ki-outline ki-credit-cart"></i>
                    <div><strong>Payments</strong><span>Catat penerimaan, pembayaran, dan alokasi invoice.</span></div>
                </a>
                <a class="quick-tile" href="@Url.Action("Index", "PurchaseOrder")">
                    <i class="ki-outline ki-truck"></i>
                    <div><strong>Purchase Orders</strong><span>@Model.PendingPurchaseOrders dokumen masih perlu ditindaklanjuti.</span></div>
                </a>
                <a class="quick-tile" href="@Url.Action("Index", "User")">
                    <i class="ki-outline ki-user-edit"></i>
                    <div><strong>User Access</strong><span>@Model.ActiveUsers users aktif dan @Model.ActiveRoles roles aktif.</span></div>
                </a>
                <a class="quick-tile" href="@Url.Action("Index", "TrialBalance")">
                    <i class="ki-outline ki-calculator"></i>
                    <div><strong>Trial Balance</strong><span>Review keseimbangan debit dan kredit periode berjalan.</span></div>
                </a>
            </div>
        </div>

        <aside class="dash-panel">
            <div class="panel-header">
                <div>
                    <h3>Recent Activity</h3>
                    <div class="text-muted fs-7">Dokumen terakhir yang berubah.</div>
                </div>
            </div>
            <div class="activity-list">
                @if (Model.RecentActivities.Any())
                {
                    foreach (var item in Model.RecentActivities)
                    {
                        <div class="activity-item">
                            <div class="activity-badge">@item.Category.Substring(0, 1)</div>
                            <div>
                                <strong>@item.Title</strong>
                                <p>@item.Description</p>
                                <small>@item.Category - @item.Date.ToLocalTime().ToString("dd MMM yyyy HH:mm")</small>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-muted">Belum ada aktivitas. Mulai dengan membuat journal atau invoice baru.</div>
                }
            </div>
        </aside>
    </section>
</div>
