@{
    ViewData["Title"] = "Stock Transfer";
}

<div class="card">
    <div class="card-body">
        <div class="row mb-5">
            <div class="col-md-3">
                <label>Status</label>
                <select class="form-select" id="filter-status">
                    <option value="">All Status</option>
                    <option value="Draft">Draft</option>
                    <option value="Posted">Posted</option>
                </select>
            </div>
            <div class="col-md-6 d-flex align-items-end justify-content-end gap-2 ms-auto">
                <button class="btn btn-primary" id="btn-apply-filter">Apply Filter</button>
                <button class="btn btn-success" id="btn-add-transfer">Add Transfer</button>
            </div>
        </div>
        <div class="table-responsive">
            <table id="transfer_datatable" class="table table-striped table-row-bordered gy-5 gs-7 border rounded w-100">
                <thead>
                    <tr>
                        <th>No</th>
                        <th>Transfer No</th>
                        <th>Date</th>
                        <th>From Warehouse</th>
                        <th>To Warehouse</th>
                        <th>Status</th>
                        <th>Lines</th>
                        <th>Total Qty</th>
                        <th>Action</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="transfer_modal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Stock Transfer</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-4 mb-5">
                    <div class="col-md-3">
                        <label>Transfer Date</label>
                        <input type="date" class="form-control" id="transfer-date" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-3">
                        <label>From Warehouse</label>
                        <select class="form-select" id="transfer-from"></select>
                    </div>
                    <div class="col-md-3">
                        <label>To Warehouse</label>
                        <select class="form-select" id="transfer-to"></select>
                    </div>
                    <div class="col-md-3">
                        <label>Notes</label>
                        <input type="text" class="form-control" id="transfer-notes" />
                    </div>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="mb-0">Items</h6>
                    <button class="btn btn-sm btn-light-primary" id="btn-add-line">Add Item</button>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-row-bordered align-middle">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th class="text-end">Quantity</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="transfer-items-body"></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btn-save-transfer">Save</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="transfer_detail_modal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Stock Transfer Detail</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="transfer-detail-content"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/custom/features/stocktransfer/index.js"></script>
}