@{
    ViewData["Title"] = "Bank Reconciliation";
}

<div class="card">
    <div class="card-body">
        <div class="row mb-5">
            <div class="col-md-3">
                <label>Status</label>
                <select class="form-select" id="filter-rstatus">
                    <option value="">All Status</option>
                    <option value="Draft">Draft</option>
                    <option value="Posted">Posted</option>
                </select>
            </div>
            <div class="col-md-6 d-flex align-items-end justify-content-end gap-2 ms-auto">
                <button class="btn btn-primary" id="btn-apply-rfilter">Apply Filter</button>
                <button class="btn btn-success" id="btn-add-reconciliation">Add Reconciliation</button>
            </div>
        </div>
        <div class="table-responsive">
            <table id="reconciliation_datatable" class="table table-striped table-row-bordered gy-5 gs-7 border rounded w-100">
                <thead>
                    <tr>
                        <th>No</th>
                        <th>Recon No</th>
                        <th>Account</th>
                        <th>Statement Date</th>
                        <th>Statement Balance</th>
                        <th>GL Balance</th>
                        <th>Lines (Cleared)</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="reconciliation_modal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Bank Reconciliation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-4 mb-4">
                    <div class="col-md-4">
                        <label>Bank Account</label>
                        <select class="form-select" id="recon-account-id"></select>
                    </div>
                    <div class="col-md-3">
                        <label>Statement Date</label>
                        <input type="date" class="form-control" id="recon-statement-date" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-3">
                        <label>Statement Ending Balance</label>
                        <input type="number" class="form-control" id="recon-statement-balance" value="0" step="0.01" />
                    </div>
                    <div class="col-md-2 d-flex align-items-end gap-2">
                        <button type="button" class="btn btn-light-primary" id="btn-load-statement">Load Statement</button>
                    </div>
                    <div class="col-md-4">
                        <label>GL Ending Balance</label>
                        <input type="number" class="form-control" id="recon-gl-balance" value="0" step="0.01" readonly />
                    </div>
                    <div class="col-md-8">
                        <label>Notes</label>
                        <input type="text" class="form-control" id="recon-notes" />
                    </div>
                </div>
                <div class="row g-4 mb-4">
                    <div class="col-md-12">
                        <div class="alert alert-warning d-none" id="recon-balance-alert"></div>
                    </div>
                </div>
                <table class="table table-sm table-bordered align-middle" id="recon-lines-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Document No</th>
                            <th>Description</th>
                            <th>Amount</th>
                            <th>Cleared</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="recon-lines-body"></tbody>
                </table>
                <button type="button" class="btn btn-sm btn-light mt-2" id="btn-add-recon-line">Add Line</button>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btn-save-reconciliation">Save</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="reconciliation_detail_modal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Reconciliation Detail</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="reconciliation-detail-content"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/custom/features/cashbank/index.js"></script>
}