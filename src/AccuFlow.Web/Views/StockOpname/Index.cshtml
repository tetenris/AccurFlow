@{
    ViewData["Title"] = "Stock Opname";
}

<div class="card">
    <div class="card-body">
        <div class="row mb-5">
            <div class="col-md-3">
                <label>Status</label>
                <select class="form-select" id="filter-status">
                    <option value="">All Status</option>
                    <option value="Draft">Draft</option>
                    <option value="Posted">Posted</option>
                </select>
            </div>
            <div class="col-md-6 d-flex align-items-end justify-content-end gap-2 ms-auto">
                <button class="btn btn-primary" id="btn-apply-filter">Apply Filter</button>
                <button class="btn btn-success" id="btn-add-opname">Add Stock Opname</button>
            </div>
        </div>
        <div class="table-responsive">
            <table id="opname_datatable" class="table table-striped table-row-bordered gy-5 gs-7 border rounded w-100">
                <thead>
                    <tr>
                        <th>No</th>
                        <th>Opname No</th>
                        <th>Date</th>
                        <th>Warehouse</th>
                        <th>Status</th>
                        <th>Lines</th>
                        <th>Total Difference</th>
                        <th>Action</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="opname_modal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Stock Opname</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-4 mb-5">
                    <div class="col-md-4">
                        <label>Opname Date</label>
                        <input type="date" class="form-control" id="opname-date" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-4">
                        <label>Warehouse</label>
                        <select class="form-select" id="opname-warehouse-id"></select>
                    </div>
                    <div class="col-md-4">
                        <label>Notes</label>
                        <input type="text" class="form-control" id="opname-notes" />
                    </div>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="mb-0">Item Quantities</h6>
                    <button class="btn btn-sm btn-light-primary" id="btn-load-items">Load Items</button>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-row-bordered align-middle">
                        <thead>
                            <tr>
                                <th>Item Code</th>
                                <th>Item Name</th>
                                <th>Unit</th>
                                <th class="text-end">System Qty</th>
                                <th class="text-end">Actual Qty</th>
                                <th class="text-end">Difference</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody id="opname-items-body">
                            <tr id="opname-items-empty"><td colspan="7" class="text-center text-muted py-5">Select a warehouse to load item quantities</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btn-save-opname">Save</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="opname_detail_modal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Stock Opname Detail</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="opname-detail-content"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/custom/features/stockopname/index.js"></script>
}