@{
    ViewData["Title"] = "Approval Workflow";
}

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="approval_datatable" class="table table-striped table-row-bordered gy-5 gs-7 border rounded w-100">
                <thead>
                    <tr>
                        <th>No</th>
                        <th>Document Type</th>
                        <th>Document ID</th>
                        <th>Status</th>
                        <th>Requested By</th>
                        <th>Requested At</th>
                        <th>Notes</th>
                        <th>Action</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/custom/features/approval/index.js"></script>
}
