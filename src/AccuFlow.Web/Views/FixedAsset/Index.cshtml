@{
    ViewData["Title"] = "Fixed Assets";
}

<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-end mb-5">
            <button class="btn btn-success" id="btn-add-asset">Add Asset</button>
        </div>
        <div class="table-responsive">
            <table id="asset_datatable" class="table table-striped table-row-bordered gy-5 gs-7 border rounded w-100">
                <thead>
                    <tr>
                        <th>No</th>
                        <th>Asset Code</th>
                        <th>Asset Name</th>
                        <th>Category</th>
                        <th>Purchase Date</th>
                        <th>Cost</th>
                        <th>Accum. Depr.</th>
                        <th>Net Book Value</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="asset_modal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Fixed Asset</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-4">
                    <div class="col-md-8">
                        <label>Asset Name</label>
                        <input type="text" class="form-control" id="asset-name" />
                    </div>
                    <div class="col-md-4">
                        <label>Category</label>
                        <select class="form-select" id="asset-category">
                            <option value="Equipment">Equipment</option>
                            <option value="Vehicle">Vehicle</option>
                            <option value="Building">Building</option>
                            <option value="Furniture">Furniture</option>
                            <option value="Computer">Computer</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label>Purchase Date</label>
                        <input type="date" class="form-control" id="asset-purchase-date" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-4">
                        <label>Purchase Cost</label>
                        <input type="number" class="form-control" id="asset-cost" step="any" min="0" />
                    </div>
                    <div class="col-md-4">
                        <label>Salvage Value</label>
                        <input type="number" class="form-control" id="asset-salvage" step="any" min="0" />
                    </div>
                    <div class="col-md-4">
                        <label>Useful Life (Months)</label>
                        <input type="number" class="form-control" id="asset-useful-life" min="1" />
                    </div>
                    <div class="col-md-8">
                        <label>Notes</label>
                        <input type="text" class="form-control" id="asset-notes" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btn-save-asset">Save</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deprec_modal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Run Depreciation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <label>Period Date</label>
                <input type="date" class="form-control mb-5" id="deprec-period" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                <p class="text-muted fs-7">Jurnal otomatis: Debit Depreciation Expense / Credit Accumulated Depreciation.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btn-run-deprec">Run</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="asset_detail_modal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Fixed Asset Detail</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="asset-detail-content"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/custom/features/fixedasset/index.js"></script>
}