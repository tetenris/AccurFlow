@{
    ViewData["Title"] = "Goods Received (GRN)";
}

<div class="card">
    <div class="card-body">
        <div class="row mb-5">
            <div class="col-md-3">
                <label>Status</label>
                <select class="form-select" id="filter-status">
                    <option value="">All Status</option>
                    <option value="Draft">Draft</option>
                    <option value="Posted">Posted</option>
                </select>
            </div>
            <div class="col-md-6 d-flex align-items-end justify-content-end gap-2 ms-auto">
                <button class="btn btn-primary" id="btn-apply-filter">Apply Filter</button>
                <button class="btn btn-success" id="btn-add-grn">Add Goods Received</button>
            </div>
        </div>
        <div class="table-responsive">
            <table id="grn_datatable" class="table table-striped table-row-bordered gy-5 gs-7 border rounded w-100">
                <thead>
                    <tr>
                        <th>No</th>
                        <th>GRN No</th>
                        <th>Receipt Date</th>
                        <th>PO No</th>
                        <th>Supplier</th>
                        <th>Warehouse</th>
                        <th>Status</th>
                        <th>Lines</th>
                        <th>Total</th>
                        <th>Action</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="grn_modal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Goods Received</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-4 mb-5">
                    <div class="col-md-4">
                        <label>Receipt Date</label>
                        <input type="date" class="form-control" id="grn-date" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-4">
                        <label>Purchase Order</label>
                        <select class="form-select" id="grn-po-id"></select>
                    </div>
                    <div class="col-md-4">
                        <label>Warehouse</label>
                        <select class="form-select" id="grn-warehouse-id"></select>
                    </div>
                    <div class="col-md-12">
                        <label>Notes</label>
                        <input type="text" class="form-control" id="grn-notes" />
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-row-bordered align-middle">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th>Description</th>
                                <th class="text-end">Ordered Qty</th>
                                <th class="text-end">Remaining</th>
                                <th class="text-end">Receive Qty</th>
                                <th class="text-end">Unit Price</th>
                                <th class="text-end">Tax</th>
                                <th class="text-end">Line Total</th>
                            </tr>
                        </thead>
                        <tbody id="grn-items-body">
                            <tr id="grn-items-empty"><td colspan="8" class="text-center text-muted py-5">Select a purchase order to load lines</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btn-save-grn">Save</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="grn_detail_modal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Goods Received Detail</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="grn-detail-content"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/custom/features/goodsreceipt/index.js"></script>
}