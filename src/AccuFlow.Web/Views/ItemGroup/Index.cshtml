@{
    ViewData["Title"] = "Item Groups";
}

<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-end mb-5">
            <button class="btn btn-success" id="btn-add-group">Add Group</button>
        </div>
        <div class="table-responsive">
            <table id="group_datatable" class="table table-striped table-row-bordered gy-5 gs-7 border rounded w-100">
                <thead>
                    <tr>
                        <th>No</th>
                        <th>Group Code</th>
                        <th>Group Name</th>
                        <th>Description</th>
                        <th>Items</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="group_modal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Item Group</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-4">
                    <div class="col-md-6">
                        <label>Group Code</label>
                        <input type="text" class="form-control" id="group-code" />
                    </div>
                    <div class="col-md-6">
                        <label>Group Name</label>
                        <input type="text" class="form-control" id="group-name" />
                    </div>
                    <div class="col-md-12">
                        <label>Description</label>
                        <input type="text" class="form-control" id="group-desc" />
                    </div>
                    <div class="col-md-6">
                        <div class="form-check form-switch mt-6">
                            <input class="form-check-input" type="checkbox" id="group-active" checked />
                            <label class="form-check-label" for="group-active">Active</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btn-save-group">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/custom/features/itemgroup/index.js"></script>
}