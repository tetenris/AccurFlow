@{
    ViewData["Title"] = "Aging Report";
}

<div class="card">
    <div class="card-body">
        <div class="row mb-5">
            <div class="col-md-3">
                <label>Aging Type</label>
                <select class="form-select" id="aging-type">
                    <option value="AR">AR Aging</option>
                    <option value="AP">AP Aging</option>
                </select>
            </div>
            <div class="col-md-3">
                <label>As Of Date</label>
                <input type="date" class="form-control" id="as-of-date" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button class="btn btn-primary" id="btn-generate">Generate</button>
            </div>
        </div>
        <div class="table-responsive">
            <table id="aging_datatable" class="table table-striped table-row-bordered gy-5 gs-7 border rounded w-100">
                <thead>
                    <tr>
                        <th>Partner Code</th>
                        <th>Partner Name</th>
                        <th>Current</th>
                        <th>1-30</th>
                        <th>31-60</th>
                        <th>61-90</th>
                        <th>>90</th>
                        <th>Total</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/custom/features/agingreport/index.js"></script>
}
