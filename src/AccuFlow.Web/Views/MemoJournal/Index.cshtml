@{
    ViewData["Title"] = "Jurnal Memo / Penyesuaian";
}

<div class="card">
    <div class="card-body">
        <div class="row mb-5">
            <div class="col-md-2">
                <label>Date From</label>
                <input type="date" class="form-control" id="filter-date-from" />
            </div>
            <div class="col-md-2">
                <label>Date To</label>
                <input type="date" class="form-control" id="filter-date-to" />
            </div>
            <div class="col-md-2">
                <label>Type</label>
                <select class="form-select" id="filter-type">
                    <option value="">All Types</option>
                    <option value="Memo">Memo</option>
                    <option value="Adjustment">Adjustment</option>
                </select>
            </div>
            <div class="col-md-2">
                <label>Status</label>
                <select class="form-select" id="filter-status">
                    <option value="">All Status</option>
                    <option value="Draft">Draft</option>
                    <option value="Posted">Posted</option>
                    <option value="Reversed">Reversed</option>
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button class="btn btn-primary" id="btn-apply-filter">Apply Filter</button>
            </div>
        </div>
        <div class="table-responsive">
            <table id="memojournal_datatable" class="table table-striped table-row-bordered gy-5 gs-7 border rounded w-100">
                <thead>
                    <tr>
                        <th>No</th>
                        <th>Journal Number</th>
                        <th>Date</th>
                        <th>Description</th>
                        <th>Total Amount</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<!-- Modal Add/Edit -->
<div class="modal fade" id="modal-memo" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-memo-title">Add Journal</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="form-memo">
                    <input type="hidden" id="memo-id" />

                    <div class="row">
                        <div class="col-md-3">
                            <div class="mb-3">
                                <label class="form-label required">Journal Type</label>
                                <select class="form-select" id="memo-type" required>
                                    <option value="Memo">Memo</option>
                                    <option value="Adjustment">Adjustment</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="mb-3">
                                <label class="form-label required">Journal Number</label>
                                <input type="text" class="form-control" id="memo-number" readonly />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="mb-3">
                                <label class="form-label required">Journal Date</label>
                                <input type="date" class="form-control" id="memo-date" required />
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label required">Description</label>
                        <textarea class="form-control" id="memo-description" rows="2" required maxlength="500"></textarea>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label">Journal Lines</label>
                            <button type="button" class="btn btn-sm btn-primary" id="btn-add-line">
                                <i class="fa fa-plus"></i> Add Line
                            </button>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-bordered" id="memo-lines-table">
                                <thead>
                                    <tr>
                                        <th width="35%">Account</th>
                                        <th width="25%">Description</th>
                                        <th width="15%">Debit</th>
                                        <th width="15%">Credit</th>
                                        <th width="10%">Action</th>
                                    </tr>
                                </thead>
                                <tbody id="memo-lines-body">
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="2" class="text-end"><strong>Total:</strong></td>
                                        <td><strong id="total-debit">0.00</strong></td>
                                        <td><strong id="total-credit">0.00</strong></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td colspan="5" class="text-center">
                                            <span id="balance-indicator"></span>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btn-save-memo">Save as Draft</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Detail -->
<div class="modal fade" id="modal-detail" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Journal Detail</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <p><strong>Journal Number:</strong> <span id="detail-number"></span></p>
                        <p><strong>Type:</strong> <span id="detail-type"></span></p>
                        <p><strong>Date:</strong> <span id="detail-date"></span></p>
                        <p><strong>Description:</strong> <span id="detail-description"></span></p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Status:</strong> <span id="detail-status"></span></p>
                        <p><strong>Created By:</strong> <span id="detail-created-by"></span></p>
                        <p><strong>Posted By:</strong> <span id="detail-posted-by"></span></p>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Line</th>
                                <th>Account</th>
                                <th>Description</th>
                                <th>Debit</th>
                                <th>Credit</th>
                            </tr>
                        </thead>
                        <tbody id="detail-lines-body">
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="text-end"><strong>Total:</strong></td>
                                <td><strong id="detail-total-debit"></strong></td>
                                <td><strong id="detail-total-credit"></strong></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-success" id="btn-post-memo" style="display:none;">Post Journal</button>
                <button type="button" class="btn btn-danger" id="btn-reverse-memo" style="display:none;">Reverse Journal</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/custom/features/memojournal/index.js"></script>
}