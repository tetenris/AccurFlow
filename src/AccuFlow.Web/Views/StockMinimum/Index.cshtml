@{
    ViewData["Title"] = "Stock Minimum";
}

<div class="card">
    <div class="card-body">
        <div class="row mb-5">
            <div class="col-md-3">
                <label class="form-check form-switch form-check-custom form-check-solid mt-8">
                    <input class="form-check-input" type="checkbox" id="filter-below-only" />
                    <span class="form-check-label">Bawah reorder point saja</span>
                </label>
            </div>
            <div class="col-md-6 d-flex align-items-end justify-content-end gap-2 ms-auto">
                <button class="btn btn-primary" id="btn-apply-filter">Apply Filter</button>
            </div>
        </div>
        <div class="table-responsive">
            <table id="stock_minimum_datatable" class="table table-striped table-row-bordered gy-5 gs-7 border rounded w-100">
                <thead>
                    <tr>
                        <th>No</th>
                        <th>Item Code</th>
                        <th>Item Name</th>
                        <th>Unit</th>
                        <th>Current Stock</th>
                        <th>Reorder Point</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="reorder_modal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Update Reorder Point</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-5">
                    <label class="form-label">Current Stock</label>
                    <input type="text" class="form-control" id="reorder-current-stock" readonly />
                </div>
                <div class="mb-5">
                    <label class="form-label">Reorder Point</label>
                    <input type="number" class="form-control" id="reorder-point" min="0" step="any" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btn-save-reorder">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/custom/features/stockminimum/index.js"></script>
}