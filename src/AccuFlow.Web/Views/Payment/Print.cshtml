@model AccuFlow.Models.Payment.PaymentDetailViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@Model.PaymentNumber</title>
    <style>
        body { font-family: Georgia, 'Times New Roman', serif; color: #18212f; margin: 36px; }
        .header { display: flex; justify-content: space-between; border-bottom: 3px solid #4b5563; padding-bottom: 18px; margin-bottom: 28px; }
        .brand { font-size: 30px; font-weight: 700; letter-spacing: 1px; }
        .title { font-size: 24px; text-align: right; text-transform: uppercase; }
        .muted { color: #667085; font-size: 13px; }
        .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 28px; }
        .box { border: 1px solid #d0d5dd; padding: 14px; border-radius: 8px; }
        table { width: 100%; border-collapse: collapse; margin-top: 18px; }
        th { background: #4b5563; color: white; text-align: left; padding: 10px; }
        td { border-bottom: 1px solid #e4e7ec; padding: 10px; }
        .right { text-align: right; }
        .total { font-size: 18px; font-weight: 700; }
        .footer { margin-top: 60px; display: flex; justify-content: space-between; }
        @@media print { .no-print { display: none; } body { margin: 20px; } }
    </style>
</head>
<body>
    <button class="no-print" onclick="window.print()">Print</button>
    <div class="header">
        <div><div class="brand">AccuFlow</div><div class="muted">Accounting & Business Flow</div></div>
        <div class="title">@Model.PaymentType<br /><span class="muted">@Model.PaymentNumber</span></div>
    </div>
    <div class="grid">
        <div class="box">
            <strong>Partner</strong><br />@Model.PartnerName<br />
            <span class="muted">Status: @Model.Status</span>
        </div>
        <div class="box">
            <strong>Date:</strong> @Model.PaymentDate.ToString("dd MMM yyyy")<br />
            <strong>Method:</strong> @Model.PaymentMethod<br />
            <strong>Cash/Bank:</strong> @Model.CashBankAccountName<br />
            <strong>Journal:</strong> @(Model.JournalNumber ?? "-")
        </div>
    </div>
    <table>
        <thead><tr><th>Invoice</th><th class="right">Allocated Amount</th></tr></thead>
        <tbody>
            @foreach (var allocation in Model.Allocations)
            {
                <tr><td>@allocation.InvoiceNumber</td><td class="right">@allocation.AllocatedAmount.ToString("N0")</td></tr>
            }
        </tbody>
        <tfoot><tr><td class="right total">Total</td><td class="right total">@Model.TotalAmount.ToString("N0")</td></tr></tfoot>
    </table>
    <p><strong>Reference:</strong> @(Model.ReferenceNumber ?? "-")</p>
    <p><strong>Notes:</strong> @(Model.Notes ?? "-")</p>
    <div class="footer"><div>Received/Paid by,</div><div>Approved by,</div></div>
</body>
</html>
