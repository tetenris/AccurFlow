@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Login - AccuFlow</title>
    <link rel="shortcut icon" href="~/img/icon-grossery.png" />
    <!--begin::Fonts(mandatory for all pages)-->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Inter:300,400,500,600,700" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Rubik:300,400,500,600,700" />
    <!--end::Fonts-->
    <!--begin::Global Stylesheets Bundle(mandatory for all pages)-->
    <link href="~/theme/metronic/default/plugins/global/plugins.bundle.css" rel="stylesheet" type="text/css" />
    <link href="~/theme/metronic/default/css/style.bundle.css" rel="stylesheet" type="text/css" />
    <!--end::Global Stylesheets Bundle-->
    <style>
        body {
            background: #F6F8FB;
        }

        .auth-brand {
            background: var(--bs-primary);
        }

        .auth-brand .brand-card {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.22);
        }

        .secure-note {
            border: 1px solid var(--bs-border-color);
            background: var(--bs-light);
            border-radius: var(--bs-border-radius-lg);
        }
    </style>
</head>
<body id="kt_body" class="app-blank">

    <!--begin::Authentication - Sign-in-->
    <div class="d-flex flex-column flex-lg-row flex-column-fluid">
        <!--begin::Aside (brand)-->
        <div class="d-flex flex-lg-row-fluid w-lg-50 order-1 order-lg-1 auth-brand">
            <div class="d-flex flex-column align-items-center justify-content-center py-7 py-lg-15 px-5 px-md-15 w-100">
                <!--begin::Brand-->
                <div class="d-flex flex-column align-items-center mb-15">
                    <img alt="Logo" src="~/img/icon-grossery.png" class="rounded-3 bg-white p-2 h-75px mb-6" />
                    <div class="text-white fs-1 fw-bolder mb-1">AccuFlow</div>
                    <div class="text-white-50 fs-5 fw-semibold">Accounting System</div>
                </div>
                <!--end::Brand-->

                <!--begin::Title-->
                <div class="text-white fw-bolder fs-2qx text-center w-lg-450px mb-6">
                    Accounting control without the clutter.
                </div>
                <!--end::Title-->

                <!--begin::Description-->
                <div class="text-white-50 fw-semibold fs-4 text-center w-lg-450px mb-12">
                    Kelola transaksi, approval, role permission, dan laporan keuangan dari satu ruang kerja yang rapi.
                </div>
                <!--end::Description-->

                <!--begin::Metrics-->
                <div class="d-flex flex-wrap justify-content-center gap-5 w-lg-500px">
                    <div class="brand-card rounded-3 p-6 text-center w-150px">
                        <div class="text-white fs-2x fw-bolder mb-1">24/7</div>
                        <div class="text-white-50 fs-7 fw-bold">Audit ready</div>
                    </div>
                    <div class="brand-card rounded-3 p-6 text-center w-150px">
                        <div class="text-white fs-2x fw-bolder mb-1">RBAC</div>
                        <div class="text-white-50 fs-7 fw-bold">Role access</div>
                    </div>
                    <div class="brand-card rounded-3 p-6 text-center w-150px">
                        <div class="text-white fs-2x fw-bolder mb-1">GL</div>
                        <div class="text-white-50 fs-7 fw-bold">Clean ledger</div>
                    </div>
                </div>
                <!--end::Metrics-->
            </div>
        </div>
        <!--end::Aside (brand)-->

        <!--begin::Body (form)-->
        <div class="d-flex flex-column flex-lg-row-fluid w-lg-50 p-10 order-2 order-lg-2">
            <!--begin::Form-->
            <div class="d-flex flex-center flex-column flex-lg-row-fluid">
                <!--begin::Wrapper-->
                <div class="w-lg-500px p-10">
                    <!--begin::Heading-->
                    <div class="text-center mb-11">
                        <img alt="Logo" src="~/img/icon-grossery.png" class="rounded-3 h-60px mb-6 d-lg-none" />
                        <h1 class="text-dark fw-bolder mb-3">Welcome back</h1>
                        <div class="text-gray-500 fw-semibold fs-6">Masuk menggunakan username atau email yang terdaftar untuk melanjutkan pekerjaan anda.</div>
                    </div>
                    <!--end::Heading-->

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger d-flex flex-column align-items-start py-5 mb-10">
                            <span class="fw-bold mb-1">Login gagal.</span>
                            <span>@Html.ValidationSummary(false, "", new { @class = "mb-0" })</span>
                        </div>
                    }

                    <!--begin::Form-->
                    <form class="form w-100" method="post" asp-action="Login" asp-controller="Account" novalidate="novalidate">
                        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                        <!--begin::Input group-->
                        <div class="fv-row mb-8">
                            <label class="form-label fw-bolder text-dark fs-6 mb-3">Username atau Email</label>
                            <div class="position-relative">
                                <i class="ki-duotone ki-user fs-2 position-absolute top-50 translate-middle-y ms-4 text-gray-400">
                                    <span class="path1"></span><span class="path2"></span>
                                </i>
                                <input id="login-username" type="text" name="username" class="form-control form-control-lg form-control-solid ps-12" placeholder="administrator@accuflow.com" required autocomplete="username" />
                            </div>
                        </div>
                        <!--end::Input group-->

                        <!--begin::Input group-->
                        <div class="fv-row mb-3">
                            <label class="form-label fw-bolder text-dark fs-6 mb-3">Password</label>
                            <div class="position-relative">
                                <i class="ki-duotone ki-lock fs-2 position-absolute top-50 translate-middle-y ms-4 text-gray-400">
                                    <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                </i>
                                <input id="login-password" type="password" name="password" class="form-control form-control-lg form-control-solid ps-12 pe-12" placeholder="Masukkan password" required autocomplete="current-password" />
                                <button class="btn btn-icon position-absolute top-50 translate-middle-y end-0 me-2" type="button" id="toggle-password" aria-label="Show password" aria-pressed="false">
                                    <i class="ki-duotone ki-eye fs-2 icon-eye">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                    </i>
                                    <i class="ki-duotone ki-eye-slash fs-2 icon-eye-off d-none">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span><span class="path4"></span>
                                    </i>
                                </button>
                            </div>
                        </div>
                        <!--end::Input group-->

                        <!--begin::Options-->
                        <div class="d-flex flex-stack justify-content-end mb-10">
                            <a asp-action="ForgotPassword" asp-controller="Account" class="link-primary fs-6 fw-bolder">Lupa password?</a>
                        </div>
                        <!--end::Options-->

                        <!--begin::Submit button-->
                        <div class="d-grid mb-10">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <span class="indicator-label">Sign In</span>
                                <span class="indicator-progress">
                                    Please wait...
                                    <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                                </span>
                            </button>
                        </div>
                        <!--end::Submit button-->

                        <div class="secure-note d-flex align-items-start p-5">
                            <i class="ki-duotone ki-information-4 fs-2x text-primary me-3">
                                <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                            </i>
                            <div class="fs-7 text-gray-600">
                                Password tidak ditampilkan di halaman user management. Jika lupa, hubungi Super Administrator untuk reset akses.
                            </div>
                        </div>
                    </form>
                    <!--end::Form-->
                </div>
                <!--end::Wrapper-->
            </div>
            <!--end::Form-->
        </div>
        <!--end::Body (form)-->
    </div>
    <!--end::Authentication - Sign-in-->

    <!--begin::Global Javascript Bundle(mandatory for all pages)-->
    <script src="~/theme/metronic/default/plugins/global/plugins.bundle.js"></script>
    <script src="~/theme/metronic/default/js/scripts.bundle.js"></script>
    <!--end::Global Javascript Bundle-->
    <script>
        (function () {
            const passwordInput = document.getElementById('login-password');
            const toggleButton = document.getElementById('toggle-password');
            const eyeIcon = toggleButton.querySelector('.icon-eye');
            const eyeOffIcon = toggleButton.querySelector('.icon-eye-off');

            toggleButton.addEventListener('click', function () {
                const isPassword = passwordInput.type === 'password';
                passwordInput.type = isPassword ? 'text' : 'password';
                eyeIcon.classList.toggle('d-none', isPassword);
                eyeOffIcon.classList.toggle('d-none', !isPassword);
                toggleButton.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
                toggleButton.setAttribute('aria-pressed', String(isPassword));
                passwordInput.focus();
            });
        })();
    </script>
</body>
</html>