@{
    ViewData["Title"] = "Chart of Accounts";
}

<div class="card">
    <div class="card-body">
        <div class="row mb-5">
            <div class="col-md-3">
                <label>Account Type</label>
                <select class="form-select" id="filter-account-type">
                    <option value="">All Types</option>
                    <option value="Asset">Asset (1) Debit</option>
                    <option value="Liability">Liability (2) Credit</option>
                    <option value="Equity">Equity (3) Credit</option>
                    <option value="Revenue">Revenue (4) Credit</option>
                    <option value="Expense">Expense (5) Debit</option>
                    <option value="Other Income">Other Income (6) Credit</option>
                    <option value="Other Expense">Other Expense (7) Debit</option>
                </select>
            </div>
            <div class="col-md-3">
                <label>Status</label>
                <select class="form-select" id="filter-status">
                    <option value="">All Status</option>
                    <option value="true">Active</option>
                    <option value="false">Inactive</option>
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button class="btn btn-primary" id="btn-apply-filter">Apply Filter</button>
            </div>
        </div>
        <div class="table-responsive">
            <table id="chartofaccount_datatable" class="table table-striped table-row-bordered gy-5 gs-7 border rounded w-100">
                <thead>
                    <tr>
                        <th>No</th>
                        <th>Account Code</th>
                        <th>Account Name</th>
                        <th>Type</th>
                        <th>Parent</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<!-- Modal Add/Edit -->
<div class="modal fade" id="modal-account" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-account-title">Add Account</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="form-account">
                    <input type="hidden" id="account-id" />
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label required">Account Type</label>
                                <select class="form-select" id="account-type" required>
                                    <option value="">Select Account Type</option>
                                    <option value="Asset">Asset (1) Debit</option>
                                    <option value="Liability">Liability (2) Credit</option>
                                    <option value="Equity">Equity (3) Credit</option>
                                    <option value="Revenue">Revenue (4) Credit</option>
                                    <option value="Expense">Expense (5) Debit</option>
                                    <option value="Other Income">Other Income (6) Credit</option>
                                    <option value="Other Expense">Other Expense (7) Debit</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label required">Account Code</label>
                                <input type="text" class="form-control" id="account-code" required maxlength="20" />
                                <small class="text-muted">Format: X-XXXXX (e.g., 1-10000)</small>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label required">Account Name</label>
                        <input type="text" class="form-control" id="account-name" required maxlength="255" />
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Parent Account</label>
                        <select class="form-select" id="parent-account">
                            <option value="">None (Root Account)</option>
                        </select>
                        <small class="text-muted">Optional - Select parent for sub-account</small>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" id="account-description" rows="3" maxlength="500"></textarea>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Opening Balance</label>
                                <input type="number" class="form-control" id="opening-balance" step="0.01" value="0" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Currency</label>
                                <input type="text" class="form-control" id="currency" value="IDR" maxlength="10" />
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="is-header" />
                            <label class="form-check-label" for="is-header">Header Account (Cannot post transactions)</label>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="is-active" checked />
                            <label class="form-check-label" for="is-active">Active</label>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btn-save-account">Save</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Import -->
<div class="modal fade" id="modal-import-account" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Import Chart of Accounts</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info d-flex align-items-center">
                    <i class="fa fa-info-circle me-2"></i>
                    <div>
                        Download the template first, fill it in, then upload. The header row and column count must match the template exactly.
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Select Excel File (.xlsx)</label>
                    <input type="file" class="form-control" id="import-file" accept=".xlsx" />
                </div>
                <div id="import-result" class="d-none">
                    <div class="alert" id="import-result-alert" role="alert"></div>
                    <div id="import-errors" class="d-none">
                        <label class="form-label fw-bold">Details:</label>
                        <div class="border rounded p-3 bg-light" style="max-height: 200px; overflow-y: auto;">
                            <ul class="mb-0 ps-3" id="import-error-list"></ul>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="btn-import-submit">Import</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Account Detail -->
<div class="modal fade" id="modal-account-detail" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Account Detail</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Account Code:</strong> <span id="detail-account-code"></span></p>
                        <p><strong>Account Name:</strong> <span id="detail-account-name"></span></p>
                        <p><strong>Account Type:</strong> <span id="detail-account-type"></span></p>
                        <p><strong>Parent Account:</strong> <span id="detail-parent-account"></span></p>
                        <p><strong>Normal Balance:</strong> <span id="detail-normal-balance"></span></p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Opening Balance:</strong> <span id="detail-opening-balance"></span></p>
                        <p><strong>Currency:</strong> <span id="detail-currency"></span></p>
                        <p><strong>Is Header:</strong> <span id="detail-is-header"></span></p>
                        <p><strong>Status:</strong> <span id="detail-status"></span></p>
                        <p><strong>Level:</strong> <span id="detail-level"></span></p>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-12">
                        <p><strong>Description:</strong></p>
                        <p id="detail-description" class="text-muted"></p>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-md-6">
                        <p><strong>Created By:</strong> <span id="detail-created-by"></span></p>
                        <p><strong>Created At:</strong> <span id="detail-created-at"></span></p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Updated By:</strong> <span id="detail-updated-by"></span></p>
                        <p><strong>Updated At:</strong> <span id="detail-updated-at"></span></p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/custom/features/chartofaccount/index.js"></script>
}
