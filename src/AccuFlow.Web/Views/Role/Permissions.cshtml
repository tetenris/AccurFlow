@model AccuFlow.Models.Role.RoleViewModel
@{
    ViewData["Title"] = $"Role Permissions";
}

<div class="card">
    <div class="card-header border-0 pt-6">
        <div class="card-title">
            <div class="d-flex align-items-center gap-3">
                <div class="symbol symbol-45px">
                    <div class="symbol-label bg-light-info text-info">
                        <i class="fa fa-key fs-2"></i>
                    </div>
                </div>
                <div>
                    <h3 class="mb-1">Role Permissions</h3>
                    <div class="text-muted fs-7">Kelola access control untuk role.</div>
                </div>
            </div>
        </div>
        <div class="card-toolbar">
            <a asp-action="Index" class="btn btn-light btn-sm">
                <i class="fa fa-arrow-left"></i> Back to Role List
            </a>
        </div>
    </div>
    <div class="card-body py-8">
        <div class="mb-4">
            <span class="fw-bold fs-6">Role:</span>
            <span class="fs-6">@Model.RoleName</span>
            <input type="hidden" id="role-id" value="@Model.RoleId" />
        </div>

        <h5 class="mb-4">Access Control</h5>

        <!-- Full Access -->
        <div class="mb-4">
            <h6>Full Access</h6>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="select-all-permissions">
                <label class="form-check-label" for="select-all-permissions">
                    Select All
                </label>
            </div>
        </div>

        <!-- Menu Permissions -->
        <div id="menu-permissions-container" style="max-height: 400px; overflow-y: auto;">
            <!-- Will be populated by JavaScript -->
        </div>

        <div class="d-flex justify-content-end mt-6 pt-3 border-top">
            <a asp-action="Index" class="btn btn-secondary me-3">Cancel</a>
            <button type="button" class="btn btn-primary" id="btn-save-permissions">Save</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/custom/features/role/permissions.js"></script>
    <script src="~/custom/features/role/permissions-page.js"></script>
}
