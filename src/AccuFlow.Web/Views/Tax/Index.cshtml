@{
    ViewData["Title"] = "Taxes";
}

<ul class="nav nav-tabs nav-line-tabs mb-5" role="tablist">
    <li class="nav-item" role="presentation">
        <a class="nav-link active" data-bs-toggle="tab" href="#tab-taxes" aria-selected="true" role="tab">Tax List</a>
    </li>
    <li class="nav-item" role="presentation">
        <a class="nav-link" data-bs-toggle="tab" href="#tab-vat-report" aria-selected="false" role="tab">PPN Report</a>
    </li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="tab-taxes" role="tabpanel">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-end mb-5">
                    <button class="btn btn-success" id="btn-add-tax">Add Tax</button>
                </div>
                <div class="table-responsive">
                    <table id="tax_datatable" class="table table-striped table-row-bordered gy-5 gs-7 border rounded w-100">
                        <thead>
                            <tr>
                                <th>No</th>
                                <th>Tax Code</th>
                                <th>Tax Name</th>
                                <th>Rate (%)</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="tab-vat-report" role="tabpanel">
        <div class="card">
            <div class="card-body">
                <div class="row mb-5">
                    <div class="col-md-3">
                        <label>From Date</label>
                        <input type="date" class="form-control" id="vat-from" value="@(new DateTime(DateTime.Today.Year, 1, 1).ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-3">
                        <label>To Date</label>
                        <input type="date" class="form-control" id="vat-to" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button class="btn btn-primary" id="btn-generate-vat">Generate</button>
                    </div>
                </div>
                <div class="row mb-5" id="vat-summary" style="display:none;">
                    <div class="col-md-4">
                        <div class="border rounded p-4">
                            <span class="text-muted fw-bold">PPN Keluaran (Output)</span>
                            <h4 id="vat-output">Rp 0</h4>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="border rounded p-4">
                            <span class="text-muted fw-bold">PPN Masukan (Input)</span>
                            <h4 id="vat-input">Rp 0</h4>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="border rounded p-4">
                            <span class="text-muted fw-bold">PPN Bersih (Net)</span>
                            <h4 id="vat-net">Rp 0</h4>
                        </div>
                    </div>
                </div>
                <div class="table-responsive">
                    <table id="vat_datatable" class="table table-striped table-row-bordered gy-5 gs-7 border rounded w-100">
                        <thead>
                            <tr>
                                <th>Invoice No</th>
                                <th>Type</th>
                                <th>Partner</th>
                                <th>Date</th>
                                <th>DPP</th>
                                <th>PPN</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="tax_modal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Tax</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-4">
                    <div class="col-md-6">
                        <label>Tax Code</label>
                        <input type="text" class="form-control" id="tax-code" />
                    </div>
                    <div class="col-md-6">
                        <label>Tax Name</label>
                        <input type="text" class="form-control" id="tax-name" />
                    </div>
                    <div class="col-md-6">
                        <label>Rate (%)</label>
                        <input type="number" class="form-control" id="tax-rate" step="any" min="0" />
                    </div>
                    <div class="col-md-6">
                        <label>Type</label>
                        <select class="form-select" id="tax-type">
                            <option value="VAT">VAT</option>
                            <option value="Withholding">Withholding</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <div class="form-check form-switch mt-6">
                            <input class="form-check-input" type="checkbox" id="tax-active" checked />
                            <label class="form-check-label" for="tax-active">Active</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btn-save-tax">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/custom/features/tax/index.js"></script>
}