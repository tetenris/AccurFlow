@{
    ViewData["Title"] = "Produksi / Manufacturing";
}

<ul class="nav nav-tabs nav-line-tabs mb-5" role="tablist">
    <li class="nav-item" role="presentation">
        <a class="nav-link active" data-bs-toggle="tab" href="#tab-bom" aria-selected="true" role="tab">Bill of Material</a>
    </li>
    <li class="nav-item" role="presentation">
        <a class="nav-link" data-bs-toggle="tab" href="#tab-production-order" aria-selected="false" role="tab">Production Order</a>
    </li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="tab-bom" role="tabpanel">
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table id="bom_datatable" class="table table-striped table-row-bordered gy-5 gs-7 border rounded w-100">
                        <thead>
                            <tr>
                                <th>No</th>
                                <th>BOM Number</th>
                                <th>Finished Item</th>
                                <th>Components</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="tab-production-order" role="tabpanel">
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table id="po_datatable" class="table table-striped table-row-bordered gy-5 gs-7 border rounded w-100">
                        <thead>
                            <tr>
                                <th>No</th>
                                <th>Order No</th>
                                <th>BOM</th>
                                <th>Finished Item</th>
                                <th>Qty</th>
                                <th>Date</th>
                                <th>Warehouse</th>
                                <th>Journal</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal BOM -->
<div class="modal fade" id="modal-bom" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Bill of Material</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label required">Finished Item</label>
                    <select class="form-select" id="bom-finished-item" required>
                        <option value="">Select Item</option>
                    </select>
                </div>
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label">Components</label>
                        <button type="button" class="btn btn-sm btn-primary" id="btn-add-bom-line"><i class="fa fa-plus"></i> Add Line</button>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Component Item</th>
                                    <th>Qty per Unit</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody id="bom-lines-body"></tbody>
                        </table>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Notes</label>
                    <textarea class="form-control" id="bom-notes" rows="2" maxlength="1000"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btn-save-bom">Save BOM</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal View BOM -->
<div class="modal fade" id="modal-view-bom" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">BOM Detail</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p><strong>BOM Number:</strong> <span id="bom-view-number"></span></p>
                <p><strong>Finished Item:</strong> <span id="bom-view-item"></span></p>
                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Component Item</th>
                                <th>Qty per Unit</th>
                            </tr>
                        </thead>
                        <tbody id="bom-view-body"></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Create Production Order -->
<div class="modal fade" id="modal-create-po" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Buat Production Order</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="form-create-po">
                    <div class="mb-3">
                        <label class="form-label required">Bill of Material</label>
                        <select class="form-select" id="po-bom" required>
                            <option value="">Select BOM</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label required">Warehouse</label>
                        <select class="form-select" id="po-warehouse" required>
                            <option value="">Select Warehouse</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label required">Quantity to Produce</label>
                        <input type="number" class="form-control" id="po-qty" step="0.01" min="0.01" value="1" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label required">Production Date</label>
                        <input type="date" class="form-control" id="po-date" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Notes</label>
                        <textarea class="form-control" id="po-notes" rows="2" maxlength="1000"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btn-save-po">Create Draft</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Detail Production Order -->
<div class="modal fade" id="modal-po-detail" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Production Order Detail</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <p><strong>Order Number:</strong> <span id="po-detail-number"></span></p>
                        <p><strong>BOM:</strong> <span id="po-detail-bom"></span></p>
                        <p><strong>Finished Item:</strong> <span id="po-detail-item"></span></p>
                        <p><strong>Quantity:</strong> <span id="po-detail-qty"></span></p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Date:</strong> <span id="po-detail-date"></span></p>
                        <p><strong>Warehouse:</strong> <span id="po-detail-wh"></span></p>
                        <p><strong>Status:</strong> <span id="po-detail-status"></span></p>
                        <p><strong>Journal:</strong> <span id="po-detail-journal"></span></p>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Component Item</th>
                                <th>Qty Required</th>
                                <th>Unit Cost</th>
                                <th>Line Cost</th>
                            </tr>
                        </thead>
                        <tbody id="po-detail-body"></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-success" id="btn-post-po" style="display:none;">Post Production</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/custom/features/production/index.js"></script>
}