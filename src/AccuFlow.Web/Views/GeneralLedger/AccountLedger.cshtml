@{
    ViewData["Title"] = "Account Ledger";
    var accountId = ViewData["AccountId"];
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title" id="page-title">@ViewData["Title"]</h3>
        <div id="toolbar-section-button"></div>
    </div>
    <div class="card-body">
        <div class="row mb-4">
            <div class="col-md-3">
                <label>Date From</label>
                <input type="date" class="form-control" id="filter-date-from" />
            </div>
            <div class="col-md-3">
                <label>Date To</label>
                <input type="date" class="form-control" id="filter-date-to" />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="button" class="btn btn-primary w-100" id="btn-apply-filter">Apply Filter</button>
            </div>
        </div>

        <div class="alert alert-info" id="opening-balance-section" style="display:none;">
            <strong>Opening Balance:</strong> <span id="opening-balance">0.00</span>
        </div>

        <div id="ledger-table">
            <table id="ledger_datatable" class="table table-striped table-row-bordered gy-5 gs-7 border rounded w-100">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Journal Number</th>
                        <th>Description</th>
                        <th>Debit</th>
                        <th>Credit</th>
                        <th>Balance</th>
                    </tr>
                </thead>
                <tbody></tbody>
                <tfoot>
                    <tr class="fw-bold">
                        <td colspan="3" class="text-end">Total:</td>
                        <td id="total-debit">0.00</td>
                        <td id="total-credit">0.00</td>
                        <td></td>
                    </tr>
                    <tr class="fw-bold">
                        <td colspan="5" class="text-end">Closing Balance:</td>
                        <td id="closing-balance">0.00</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

<input type="hidden" id="account-id" value="@accountId" />

@section Scripts {
    <script src="~/custom/features/generalledger/ledger.js"></script>
}
