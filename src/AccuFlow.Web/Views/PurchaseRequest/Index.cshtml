@{
    ViewData["Title"] = "Purchase Request";
}

<div class="card">
    <div class="card-body">
        <div class="row mb-5">
            <div class="col-md-3">
                <label>Status</label>
                <select class="form-select" id="filter-status">
                    <option value="">All Status</option>
                    <option value="Draft">Draft</option>
                    <option value="Approved">Approved</option>
                    <option value="Converted">Converted</option>
                </select>
            </div>
            <div class="col-md-6 d-flex align-items-end justify-content-end gap-2 ms-auto">
                <button class="btn btn-primary" id="btn-apply-filter">Apply Filter</button>
                <button class="btn btn-success" id="btn-add-pr">Add Purchase Request</button>
            </div>
        </div>
        <div class="table-responsive">
            <table id="pr_datatable" class="table table-striped table-row-bordered gy-5 gs-7 border rounded w-100">
                <thead>
                    <tr>
                        <th>No</th>
                        <th>PR No</th>
                        <th>Request Date</th>
                        <th>Required</th>
                        <th>Requested By</th>
                        <th>Department</th>
                        <th>Status</th>
                        <th>Lines</th>
                        <th>Total</th>
                        <th>PO</th>
                        <th>Action</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="pr_modal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Purchase Request</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-4 mb-5">
                    <div class="col-md-3">
                        <label>Request Date</label>
                        <input type="date" class="form-control" id="pr-date" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-3">
                        <label>Required Date</label>
                        <input type="date" class="form-control" id="pr-required-date" />
                    </div>
                    <div class="col-md-3">
                        <label>Requested By</label>
                        <input type="text" class="form-control" id="pr-requested-by" placeholder="Leave empty for current user" />
                    </div>
                    <div class="col-md-3">
                        <label>Department</label>
                        <input type="text" class="form-control" id="pr-department" />
                    </div>
                    <div class="col-md-12">
                        <label>Notes</label>
                        <input type="text" class="form-control" id="pr-notes" />
                    </div>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="mb-0">Lines</h6>
                    <button class="btn btn-sm btn-light-primary" id="btn-add-pr-line">Add Line</button>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-row-bordered align-middle">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th>Description</th>
                                <th class="text-end">Qty</th>
                                <th class="text-end">Unit Price</th>
                                <th class="text-end">Tax</th>
                                <th class="text-end">Line Total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="pr-items-body"></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btn-save-pr">Save</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="pr_convert_modal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Convert to Purchase Order</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-4">
                    <div class="col-md-12">
                        <label>Supplier</label>
                        <select class="form-select" id="convert-supplier-id"></select>
                    </div>
                    <div class="col-md-12">
                        <label>Expected Date</label>
                        <input type="date" class="form-control" id="convert-expected-date" />
                    </div>
                </div>
                <div class="form-text mt-3">Purchase order akan dibuat berstatus Draft dari semua line purchase request ini.</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btn-confirm-convert">Convert</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="pr_detail_modal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Purchase Request Detail</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="pr-detail-content"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/custom/features/purchaserequest/index.js"></script>
}