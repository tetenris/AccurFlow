@{
    ViewData["Title"] = "Purchase Orders";
}

<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-end mb-5">
            <button class="btn btn-success" id="btn-add-po">Add Purchase Order</button>
        </div>
        <div class="table-responsive">
            <table id="purchase_order_datatable" class="table table-striped table-row-bordered gy-5 gs-7 border rounded w-100">
                <thead>
                    <tr>
                        <th>No</th>
                        <th>PO No</th>
                        <th>Order Date</th>
                        <th>Expected Date</th>
                        <th>Supplier</th>
                        <th>Status</th>
                        <th>Total</th>
                        <th>Action</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="po_modal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create Purchase Order</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-4">
                    <div class="col-md-4">
                        <label>Order Date</label>
                        <input type="date" class="form-control" id="order-date" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-4">
                        <label>Expected Date</label>
                        <input type="date" class="form-control" id="expected-date" />
                    </div>
                    <div class="col-md-4">
                        <label>Supplier</label>
                        <select class="form-select" id="po-supplier-id"></select>
                    </div>
                    <div class="col-md-6">
                        <label>Item</label>
                        <select class="form-select" id="po-item-id"></select>
                    </div>
                    <div class="col-md-6">
                        <label>Description</label>
                        <input type="text" class="form-control" id="po-description" />
                    </div>
                    <div class="col-md-4">
                        <label>Quantity</label>
                        <input type="number" class="form-control" id="po-quantity" value="1" min="1" />
                    </div>
                    <div class="col-md-4">
                        <label>Unit Price</label>
                        <input type="number" class="form-control" id="po-unit-price" value="0" min="0" />
                    </div>
                    <div class="col-md-4">
                        <label>Tax</label>
                        <input type="number" class="form-control" id="po-tax-amount" value="0" min="0" />
                    </div>
                    <div class="col-md-12">
                        <label>Notes</label>
                        <textarea class="form-control" id="po-notes"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btn-save-po">Save</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="po_detail_modal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Purchase Order Detail</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="po-detail-content"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/custom/features/purchaseorder/index.js"></script>
}
