@{
    ViewData["Title"] = "Supplier Management";
}

<div class="card">
    <div class="card-body">
        <div class="row mb-5">
            <div class="col-md-3">
                <label>Supplier Type</label>
                <select class="form-select" id="filter-supplier-type">
                    <option value="">All Types</option>
                    <option value="Individual">Individual</option>
                    <option value="Corporate">Corporate</option>
                    <option value="Government">Government</option>
                </select>
            </div>
            <div class="col-md-3">
                <label>Status</label>
                <select class="form-select" id="filter-status">
                    <option value="">All Status</option>
                    <option value="true">Active</option>
                    <option value="false">Inactive</option>
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button class="btn btn-primary" id="btn-apply-filter">Apply Filter</button>
            </div>
        </div>
        <div class="table-responsive">
            <table id="supplier_datatable" class="table table-striped table-row-bordered gy-5 gs-7 border rounded w-100">
                <thead>
                    <tr>
                        <th>No</th>
                        <th>Supplier Code</th>
                        <th>Supplier Name</th>
                        <th>Type</th>
                        <th>Contact Person</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<!-- Modal Add/Edit -->
<div class="modal fade" id="modal-supplier" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-supplier-title">Add Supplier</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="form-supplier">
                    <input type="hidden" id="supplier-id" />
                    
                    <!-- Nav tabs -->
                    <ul class="nav nav-tabs mb-3" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="basic-tab" data-bs-toggle="tab" data-bs-target="#basic-info" type="button">Basic Info</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="contact-tab" data-bs-toggle="tab" data-bs-target="#contact-info" type="button">Contact</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="address-tab" data-bs-toggle="tab" data-bs-target="#address-info" type="button">Address</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="financial-tab" data-bs-toggle="tab" data-bs-target="#financial-info" type="button">Financial</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="additional-tab" data-bs-toggle="tab" data-bs-target="#additional-info" type="button">Additional</button>
                        </li>
                    </ul>
                    
                    <!-- Tab content -->
                    <div class="tab-content">
                        <!-- Basic Info Tab -->
                        <div class="tab-pane fade show active" id="basic-info" role="tabpanel">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label required">Supplier Code</label>
                                        <input type="text" class="form-control" id="supplier-code" required maxlength="20" />
                                        <small class="text-muted">Format: SUPP-XXXXX</small>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label required">Supplier Type</label>
                                        <select class="form-select" id="supplier-type" required>
                                            <option value="">Select Type</option>
                                            <option value="Individual">Individual</option>
                                            <option value="Corporate">Corporate</option>
                                            <option value="Government">Government</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label required">Supplier Name</label>
                                <input type="text" class="form-control" id="supplier-name" required maxlength="255" />
                            </div>
                            <div class="mb-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="supplier-active" checked />
                                    <label class="form-check-label" for="supplier-active">Active</label>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Contact Info Tab -->
                        <div class="tab-pane fade" id="contact-info" role="tabpanel">
                            <div class="mb-3">
                                <label class="form-label">Contact Person</label>
                                <input type="text" class="form-control" id="contact-person" maxlength="255" />
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Phone</label>
                                        <input type="text" class="form-control" id="phone" maxlength="50" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Email</label>
                                        <input type="email" class="form-control" id="email" maxlength="255" />
                                    </div>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Website</label>
                                <input type="text" class="form-control" id="website" maxlength="255" />
                            </div>
                        </div>
                        
                        <!-- Address Info Tab -->
                        <div class="tab-pane fade" id="address-info" role="tabpanel">
                            <div class="mb-3">
                                <label class="form-label">Address</label>
                                <textarea class="form-control" id="address" rows="3" maxlength="500"></textarea>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">City</label>
                                        <input type="text" class="form-control" id="city" maxlength="100" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">State</label>
                                        <input type="text" class="form-control" id="state" maxlength="100" />
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Postal Code</label>
                                        <input type="text" class="form-control" id="postal-code" maxlength="20" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Country</label>
                                        <input type="text" class="form-control" id="country" maxlength="100" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Financial Info Tab -->
                        <div class="tab-pane fade" id="financial-info" role="tabpanel">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Credit Limit</label>
                                        <input type="number" class="form-control" id="credit-limit" step="0.01" value="0" min="0" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Payment Terms (days)</label>
                                        <input type="number" class="form-control" id="payment-terms" value="30" min="1" max="365" />
                                    </div>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Tax ID</label>
                                <input type="text" class="form-control" id="tax-id" maxlength="50" />
                            </div>
                        </div>
                        
                        <!-- Additional Info Tab -->
                        <div class="tab-pane fade" id="additional-info" role="tabpanel">
                            <div class="mb-3">
                                <label class="form-label">Notes</label>
                                <textarea class="form-control" id="notes" rows="5" maxlength="1000"></textarea>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btn-save-supplier">Save</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Detail -->
<div class="modal fade" id="modal-supplier-detail" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Supplier Detail</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- Nav tabs -->
                <ul class="nav nav-tabs mb-3" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#detail-basic" type="button">Basic Info</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#detail-contact" type="button">Contact</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#detail-address" type="button">Address</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#detail-financial" type="button">Financial</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#detail-additional" type="button">Additional</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#detail-audit" type="button">Audit</button>
                    </li>
                </ul>
                
                <!-- Tab content -->
                <div class="tab-content">
                    <!-- Basic Info Tab -->
                    <div class="tab-pane fade show active" id="detail-basic" role="tabpanel">
                        <div class="row">
                            <div class="col-md-6">
                                <p><strong>Supplier Code:</strong> <span id="detail-supplier-code"></span></p>
                                <p><strong>Supplier Name:</strong> <span id="detail-supplier-name"></span></p>
                            </div>
                            <div class="col-md-6">
                                <p><strong>Supplier Type:</strong> <span id="detail-supplier-type"></span></p>
                                <p><strong>Status:</strong> <span id="detail-status"></span></p>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Contact Info Tab -->
                    <div class="tab-pane fade" id="detail-contact" role="tabpanel">
                        <div class="row">
                            <div class="col-md-6">
                                <p><strong>Contact Person:</strong> <span id="detail-contact-person"></span></p>
                                <p><strong>Phone:</strong> <span id="detail-phone"></span></p>
                            </div>
                            <div class="col-md-6">
                                <p><strong>Email:</strong> <span id="detail-email"></span></p>
                                <p><strong>Website:</strong> <span id="detail-website"></span></p>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Address Info Tab -->
                    <div class="tab-pane fade" id="detail-address" role="tabpanel">
                        <div class="row">
                            <div class="col-md-12">
                                <p><strong>Address:</strong> <span id="detail-address"></span></p>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <p><strong>City:</strong> <span id="detail-city"></span></p>
                                <p><strong>State:</strong> <span id="detail-state"></span></p>
                            </div>
                            <div class="col-md-6">
                                <p><strong>Postal Code:</strong> <span id="detail-postal-code"></span></p>
                                <p><strong>Country:</strong> <span id="detail-country"></span></p>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Financial Info Tab -->
                    <div class="tab-pane fade" id="detail-financial" role="tabpanel">
                        <div class="row">
                            <div class="col-md-6">
                                <p><strong>Credit Limit:</strong> <span id="detail-credit-limit"></span></p>
                                <p><strong>Payment Terms:</strong> <span id="detail-payment-terms"></span></p>
                            </div>
                            <div class="col-md-6">
                                <p><strong>Current Balance:</strong> <span id="detail-current-balance"></span></p>
                                <p><strong>Tax ID:</strong> <span id="detail-tax-id"></span></p>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Additional Info Tab -->
                    <div class="tab-pane fade" id="detail-additional" role="tabpanel">
                        <div class="row">
                            <div class="col-md-12">
                                <p><strong>Notes:</strong></p>
                                <p id="detail-notes" class="text-muted"></p>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Audit Info Tab -->
                    <div class="tab-pane fade" id="detail-audit" role="tabpanel">
                        <div class="row">
                            <div class="col-md-6">
                                <p><strong>Created By:</strong> <span id="detail-created-by"></span></p>
                                <p><strong>Created At:</strong> <span id="detail-created-at"></span></p>
                            </div>
                            <div class="col-md-6">
                                <p><strong>Updated By:</strong> <span id="detail-updated-by"></span></p>
                                <p><strong>Updated At:</strong> <span id="detail-updated-at"></span></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/custom/features/supplier/index.js"></script>
}
