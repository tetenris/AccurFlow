@{
    ViewData["Title"] = "Serial Number / Batch";
}

<div class="card">
    <div class="card-body">
        <div class="row mb-5">
            <div class="col-md-3">
                <label>Item</label>
                <select class="form-select" id="filter-item">
                    <option value="">All Items</option>
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button class="btn btn-primary" id="btn-apply-filter">Apply Filter</button>
            </div>
        </div>
        <div class="table-responsive">
            <table id="serialbatch_datatable" class="table table-striped table-row-bordered gy-5 gs-7 border rounded w-100">
                <thead>
                    <tr>
                        <th>No</th>
                        <th>Item Code</th>
                        <th>Item Name</th>
                        <th>Batch / Serial</th>
                        <th>Expiry</th>
                        <th>Qty</th>
                        <th>Remaining</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<!-- Modal Register -->
<div class="modal fade" id="modal-batch" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Register Batch / Serial</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="form-batch">
                    <div class="mb-3">
                        <label class="form-label required">Item</label>
                        <select class="form-select" id="batch-item" required>
                            <option value="">Select Item</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label required">Batch / Serial Number</label>
                        <input type="text" class="form-control" id="batch-number" required maxlength="100" placeholder="e.g. LOT-20260801 / SN-0001" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label required">Quantity</label>
                        <input type="number" class="form-control" id="batch-quantity" step="0.01" min="0.01" value="1" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Expiry Date</label>
                        <input type="date" class="form-control" id="batch-expiry" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Notes</label>
                        <textarea class="form-control" id="batch-notes" rows="2" maxlength="1000"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btn-save-batch">Register</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/custom/features/serialbatch/index.js"></script>
}