@{
    ViewData["Title"] = "Payroll / HRM";
}

<ul class="nav nav-tabs nav-line-tabs mb-5" role="tablist">
    <li class="nav-item" role="presentation">
        <a class="nav-link active" data-bs-toggle="tab" href="#tab-employees" aria-selected="true" role="tab">Data Karyawan</a>
    </li>
    <li class="nav-item" role="presentation">
        <a class="nav-link" data-bs-toggle="tab" href="#tab-payroll" aria-selected="false" role="tab">Penggajian</a>
    </li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="tab-employees" role="tabpanel">
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table id="employee_datatable" class="table table-striped table-row-bordered gy-5 gs-7 border rounded w-100">
                        <thead>
                            <tr>
                                <th>No</th>
                                <th>Code</th>
                                <th>Employee Name</th>
                                <th>Position</th>
                                <th>Department</th>
                                <th>Hire Date</th>
                                <th>Basic Salary</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="tab-payroll" role="tabpanel">
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table id="payroll_datatable" class="table table-striped table-row-bordered gy-5 gs-7 border rounded w-100">
                        <thead>
                            <tr>
                                <th>No</th>
                                <th>Number</th>
                                <th>Period</th>
                                <th>Payroll Date</th>
                                <th>Employees</th>
                                <th>Net Salary</th>
                                <th>Journal</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Employee -->
<div class="modal fade" id="modal-employee" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-employee-title">Add Employee</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="form-employee">
                    <input type="hidden" id="employee-id" />
                    <div class="mb-3">
                        <label class="form-label required">Employee Code</label>
                        <input type="text" class="form-control" id="emp-code" required maxlength="50" placeholder="e.g. EMP-0001" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label required">Full Name</label>
                        <input type="text" class="form-control" id="emp-name" required maxlength="200" />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Position</label>
                            <input type="text" class="form-control" id="emp-position" maxlength="100" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Department</label>
                            <input type="text" class="form-control" id="emp-department" maxlength="100" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Hire Date</label>
                        <input type="date" class="form-control" id="emp-hire-date" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label required">Basic Salary</label>
                        <input type="number" class="form-control" id="emp-salary" step="0.01" min="0" value="0" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Bank Account No</label>
                        <input type="text" class="form-control" id="emp-bank" maxlength="50" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btn-save-employee">Save</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Create Payroll -->
<div class="modal fade" id="modal-create-payroll" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Buat Penggajian</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="form-create-payroll">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label required">Periode Bulan</label>
                            <select class="form-select" id="pr-month" required>
                                @for (var m = 1; m <= 12; m++)
                                {
                                    <option value="@m" selected="@(m == DateTime.Today.Month)">@m</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label required">Periode Tahun</label>
                            <input type="number" class="form-control" id="pr-year" value="@DateTime.Today.Year" min="2000" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label required">Payroll Date</label>
                        <input type="date" class="form-control" id="pr-date" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Notes</label>
                        <textarea class="form-control" id="pr-notes" rows="2" maxlength="1000"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btn-save-payroll">Create Draft</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Detail Payroll -->
<div class="modal fade" id="modal-payroll-detail" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="detail-payroll-title">Payroll Detail</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <p><strong>Payroll Number:</strong> <span id="detail-number"></span></p>
                        <p><strong>Periode:</strong> <span id="detail-period"></span></p>
                        <p><strong>Payroll Date:</strong> <span id="detail-date"></span></p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Status:</strong> <span id="detail-status"></span></p>
                        <p><strong>Journal:</strong> <span id="detail-journal"></span></p>
                        <p><strong>Total Net Salary:</strong> <span id="detail-total"></span></p>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Employee</th>
                                <th>Basic Salary</th>
                                <th>Allowances</th>
                                <th>Deductions</th>
                                <th>Net Salary</th>
                            </tr>
                        </thead>
                        <tbody id="detail-lines-body"></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-success" id="btn-post-payroll" style="display:none;">Post Payroll</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/custom/features/payroll/index.js"></script>
}