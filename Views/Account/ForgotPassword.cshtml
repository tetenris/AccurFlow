@model AccuFlow.Models.Account.ForgotPasswordViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Forgot Password - AccuFlow</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,650;9..144,750&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="~/assets/plugins/global/plugins.bundle.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/css/style.bundle.css" rel="stylesheet" type="text/css" />
    <style>
        :root {
            --ink: #17312f;
            --muted: #647a76;
            --card: rgba(255, 252, 246, 0.9);
            --teal: #0f8f7f;
            --teal-deep: #0c5f57;
            --gold: #d99a2b;
            --coral: #d96b4b;
        }

        body {
            min-height: 100vh;
            margin: 0;
            display: grid;
            place-items: center;
            padding: 28px;
            color: var(--ink);
            font-family: 'Manrope', sans-serif;
            background:
                radial-gradient(circle at 16% 20%, rgba(217, 154, 43, 0.24), transparent 30%),
                radial-gradient(circle at 82% 18%, rgba(15, 143, 127, 0.22), transparent 28%),
                linear-gradient(135deg, #fbf5eb 0%, #e7f3ed 58%, #f6eadb 100%);
        }

        .reset-card {
            width: min(100%, 480px);
            padding: 42px;
            border: 1px solid rgba(23, 49, 47, 0.12);
            border-radius: 32px;
            background: var(--card);
            box-shadow: 0 28px 70px rgba(19, 49, 47, 0.16);
            backdrop-filter: blur(18px);
        }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 26px;
            color: var(--teal-deep);
            font-weight: 900;
            letter-spacing: -0.03em;
        }

        h1 {
            margin: 0 0 10px;
            font-family: 'Fraunces', serif;
            font-size: clamp(34px, 8vw, 48px);
            letter-spacing: -0.055em;
        }

        p {
            margin: 0 0 28px;
            color: var(--muted);
            line-height: 1.7;
        }

        .field-label {
            display: block;
            margin-bottom: 9px;
            font-size: 13px;
            font-weight: 800;
        }

        .form-control-modern {
            width: 100%;
            height: 56px;
            padding: 0 18px;
            border: 1px solid rgba(23, 49, 47, 0.12);
            border-radius: 18px;
            outline: none;
            color: var(--ink);
            background: rgba(255, 255, 255, 0.8);
            font-size: 15px;
            font-weight: 700;
        }

        .form-control-modern:focus {
            border-color: rgba(15, 143, 127, 0.55);
            box-shadow: 0 0 0 5px rgba(15, 143, 127, 0.12);
        }

        .btn-submit {
            width: 100%;
            height: 56px;
            margin-top: 20px;
            border: 0;
            border-radius: 18px;
            color: #fff;
            background: linear-gradient(135deg, var(--teal-deep), var(--teal));
            box-shadow: 0 18px 32px rgba(15, 143, 127, 0.26);
            font-weight: 900;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .back-link {
            display: inline-flex;
            margin-top: 22px;
            color: var(--teal-deep);
            font-weight: 800;
            text-decoration: none;
        }

        .alert-modern {
            margin-bottom: 18px;
            padding: 14px 16px;
            border-radius: 16px;
            font-size: 13px;
        }

        .alert-success-modern {
            color: #0c5f57;
            background: rgba(15, 143, 127, 0.12);
            border: 1px solid rgba(15, 143, 127, 0.2);
        }

        .alert-error-modern {
            color: #9c3d29;
            background: rgba(217, 107, 75, 0.1);
            border: 1px solid rgba(217, 107, 75, 0.22);
        }
    </style>
</head>
<body>
    <main class="reset-card">
        <div class="brand"><i class="fa fa-chart-line"></i> AccuFlow</div>
        <h1>Reset password</h1>
        <p>Masukkan email akun anda. Untuk saat ini email belum aktif, jadi halaman ini menyiapkan flow reset password tanpa mengirim email sungguhan.</p>

        @if (ViewBag.SuccessMessage != null)
        {
            <div class="alert-modern alert-success-modern">@ViewBag.SuccessMessage</div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert-modern alert-error-modern">@Html.ValidationSummary(false)</div>
        }

        <form method="post" asp-action="ForgotPassword" asp-controller="Account">
            <label class="field-label" asp-for="Email">Email</label>
            <input asp-for="Email" class="form-control-modern" placeholder="nama@perusahaan.com" autocomplete="email" />
            <button type="submit" class="btn-submit">Request Reset</button>
        </form>

        <a class="back-link" asp-action="Login" asp-controller="Account">Back to login</a>
    </main>
</body>
</html>
