@model AccuFlow.Models.Account.ForgotPasswordViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Forgot Password - AccuFlow</title>
    <link rel="shortcut icon" href="~/img/icon-grossery.png" />
    <!--begin::Fonts(mandatory for all pages)-->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Inter:300,400,500,600,700" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Rubik:300,400,500,600,700" />
    <!--end::Fonts-->
    <!--begin::Global Stylesheets Bundle(mandatory for all pages)-->
    <link href="~/theme/metronic/default/plugins/global/plugins.bundle.css" rel="stylesheet" type="text/css" />
    <link href="~/theme/metronic/default/css/style.bundle.css" rel="stylesheet" type="text/css" />
    <!--end::Global Stylesheets Bundle-->
    <style>
        body {
            min-height: 100vh;
            margin: 0;
            display: grid;
            place-items: center;
            padding: 20px;
            background: #F6F8FB;
        }

        .secure-note {
            border: 1px solid var(--bs-border-color);
            background: var(--bs-light);
            border-radius: var(--bs-border-radius-lg);
        }
    </style>
</head>
<body id="kt_body" class="app-blank">

    <!--begin::Authentication - Forgot Password-->
    <div class="card shadow-sm border-0 w-100" style="max-width: 480px;">
        <div class="card-body p-10">
            <!--begin::Heading-->
            <div class="text-center mb-10">
                <img alt="Logo" src="~/img/icon-grossery.png" class="rounded-3 h-75px mb-6" />
                <h1 class="text-dark fw-bolder mb-3">Reset password</h1>
                <div class="text-gray-500 fw-semibold fs-6">Masukkan email akun anda untuk memulai proses reset password.</div>
            </div>
            <!--end::Heading-->

            @if (ViewBag.SuccessMessage != null)
            {
                <div class="alert alert-success d-flex align-items-center py-5 mb-10">
                    <i class="ki-duotone ki-check-circle fs-2x me-3">
                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                    </i>
                    <div class="d-flex flex-column">
                        <span class="fw-bold">@ViewBag.SuccessMessage</span>
                    </div>
                </div>
            }

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger d-flex flex-column align-items-start py-5 mb-10">
                    <span class="fw-bold mb-1">Permintaan gagal.</span>
                    <span>@Html.ValidationSummary(false, "", new { @class = "mb-0" })</span>
                </div>
            }

            <!--begin::Form-->
            <form class="form w-100" method="post" asp-action="ForgotPassword" asp-controller="Account" novalidate="novalidate">
                <!--begin::Input group-->
                <div class="fv-row mb-8">
                    <label class="form-label fw-bolder text-dark fs-6 mb-3" asp-for="Email">Email</label>
                    <div class="position-relative">
                        <i class="ki-duotone ki-sms fs-2 position-absolute top-50 translate-middle-y ms-4 text-gray-400">
                            <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                        </i>
                        <input asp-for="Email" type="email" class="form-control form-control-lg form-control-solid ps-12" placeholder="nama@perusahaan.com" autocomplete="email" />
                    </div>
                </div>
                <!--end::Input group-->

                <!--begin::Submit button-->
                <div class="d-grid mb-5">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <span class="indicator-label">Request Reset</span>
                        <span class="indicator-progress">
                            Please wait...
                            <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                        </span>
                    </button>
                </div>
                <!--end::Submit button-->

                <div class="secure-note d-flex align-items-start p-5">
                    <i class="ki-duotone ki-information-4 fs-2x text-primary me-3">
                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                    </i>
                    <div class="fs-7 text-gray-600">
                        Layanan email belum aktif. Saat diaktifkan, instruksi reset password akan dikirim ke email yang terdaftar.
                    </div>
                </div>

                <!--begin::Back link-->
                <div class="d-flex flex-center pt-5">
                    <a asp-action="Login" asp-controller="Account" class="link-primary fw-bolder fs-6">
                        <i class="ki-duotone ki-arrow-left fs-2 me-1 align-middle">
                            <span class="path1"></span><span class="path2"></span>
                        </i>
                        Back to login
                    </a>
                </div>
                <!--end::Back link-->
            </form>
            <!--end::Form-->
        </div>
    </div>
    <!--end::Authentication - Forgot Password-->

    <!--begin::Global Javascript Bundle(mandatory for all pages)-->
    <script src="~/theme/metronic/default/plugins/global/plugins.bundle.js"></script>
    <script src="~/theme/metronic/default/js/scripts.bundle.js"></script>
    <!--end::Global Javascript Bundle-->
</body>
</html>