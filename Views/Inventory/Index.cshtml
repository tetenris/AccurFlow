@{
    ViewData["Title"] = "Inventory Items";
}

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="item_datatable" class="table table-striped table-row-bordered gy-5 gs-7 border rounded w-100">
                <thead>
                    <tr>
                        <th>No</th>
                        <th>Item Code</th>
                        <th>Item Name</th>
                        <th>Type</th>
                        <th>Group</th>
                        <th>Unit</th>
                        <th>Sales Price</th>
                        <th>Purchase Price</th>
                        <th>Status</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/custom/features/inventory/index.js"></script>
}
