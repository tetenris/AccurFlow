@{
    ViewData["Title"] = "Cash Bank Transfers";
}

<div class="card">
    <div class="card-body">
        <div class="row mb-5">
            <div class="col-md-3">
                <label>Status</label>
                <select class="form-select" id="filter-status">
                    <option value="">All Status</option>
                    <option value="Draft">Draft</option>
                    <option value="Posted">Posted</option>
                </select>
            </div>
            <div class="col-md-6 d-flex align-items-end justify-content-end gap-2 ms-auto">
                <button class="btn btn-primary" id="btn-apply-filter">Apply Filter</button>
                <button class="btn btn-success" id="btn-add-transfer">Add Transfer</button>
            </div>
        </div>
        <div class="table-responsive">
            <table id="transfer_datatable" class="table table-striped table-row-bordered gy-5 gs-7 border rounded w-100">
                <thead>
                    <tr>
                        <th>No</th>
                        <th>Transfer No</th>
                        <th>Date</th>
                        <th>From</th>
                        <th>To</th>
                        <th>Status</th>
                        <th>Amount</th>
                        <th>Action</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="transfer_modal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cash Bank Transfer</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-4">
                    <div class="col-md-4">
                        <label>Date</label>
                        <input type="date" class="form-control" id="transfer-date" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-4">
                        <label>From Account</label>
                        <select class="form-select" id="from-account-id"></select>
                    </div>
                    <div class="col-md-4">
                        <label>To Account</label>
                        <select class="form-select" id="to-account-id"></select>
                    </div>
                    <div class="col-md-4">
                        <label>Amount</label>
                        <input type="number" class="form-control" id="transfer-amount" value="0" min="0" />
                    </div>
                    <div class="col-md-8">
                        <label>Reference No</label>
                        <input type="text" class="form-control" id="reference-number" />
                    </div>
                    <div class="col-md-12">
                        <label>Description</label>
                        <input type="text" class="form-control" id="transfer-description" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btn-save-transfer">Save</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="transfer_detail_modal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Transfer Detail</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="transfer-detail-content"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/custom/features/cashbank/index.js"></script>
}