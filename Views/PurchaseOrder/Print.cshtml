@model AccuFlow.Models.PurchaseOrder.PurchaseOrderDetailViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@Model.PurchaseOrderNumber</title>
    <style>
        body { font-family: Georgia, 'Times New Roman', serif; color: #18212f; margin: 36px; }
        .header { display: flex; justify-content: space-between; border-bottom: 3px solid #365314; padding-bottom: 18px; margin-bottom: 28px; }
        .brand { font-size: 30px; font-weight: 700; letter-spacing: 1px; }
        .title { font-size: 24px; text-align: right; text-transform: uppercase; }
        .muted { color: #667085; font-size: 13px; }
        .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 28px; }
        .box { border: 1px solid #d0d5dd; padding: 14px; border-radius: 8px; }
        table { width: 100%; border-collapse: collapse; margin-top: 18px; }
        th { background: #365314; color: white; text-align: left; padding: 10px; }
        td { border-bottom: 1px solid #e4e7ec; padding: 10px; }
        .right { text-align: right; }
        .total { font-size: 18px; font-weight: 700; }
        .footer { margin-top: 60px; display: flex; justify-content: space-between; }
        @@media print { .no-print { display: none; } body { margin: 20px; } }
    </style>
</head>
<body>
    <button class="no-print" onclick="window.print()">Print</button>
    <div class="header">
        <div><div class="brand">AccuFlow</div><div class="muted">Accounting & Business Flow</div></div>
        <div class="title">Purchase Order<br /><span class="muted">@Model.PurchaseOrderNumber</span></div>
    </div>
    <div class="grid">
        <div class="box"><strong>Supplier</strong><br />@Model.SupplierName<br /><span class="muted">Status: @Model.Status</span></div>
        <div class="box">
            <strong>Order Date:</strong> @Model.OrderDate.ToString("dd MMM yyyy")<br />
            <strong>Expected Date:</strong> @(Model.ExpectedDate?.ToString("dd MMM yyyy") ?? "-")<br />
            <strong>Invoice:</strong> @(Model.PurchaseInvoiceNumber ?? "-")
        </div>
    </div>
    <table>
        <thead><tr><th>Description</th><th class="right">Qty</th><th class="right">Price</th><th class="right">Tax</th><th class="right">Total</th></tr></thead>
        <tbody>
            @foreach (var line in Model.Lines)
            {
                <tr>
                    <td>@line.Description</td>
                    <td class="right">@line.Quantity.ToString("N2")</td>
                    <td class="right">@line.UnitPrice.ToString("N0")</td>
                    <td class="right">@line.TaxAmount.ToString("N0")</td>
                    <td class="right">@line.LineTotal.ToString("N0")</td>
                </tr>
            }
        </tbody>
        <tfoot><tr><td colspan="4" class="right total">Total</td><td class="right total">@Model.TotalAmount.ToString("N0")</td></tr></tfoot>
    </table>
    <p><strong>Notes:</strong> @(Model.Notes ?? "-")</p>
    <div class="footer"><div>Prepared by,</div><div>Approved by,</div></div>
</body>
</html>
