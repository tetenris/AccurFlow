@model AccuFlow.Models.Role.RoleViewModel
@{
    ViewData["Title"] = $"Edit Role";
}

<div class="card">
    <div class="card-header border-0 pt-6">
        <div class="card-title">
            <div class="d-flex align-items-center gap-3">
                <div class="symbol symbol-45px">
                    <div class="symbol-label bg-light-warning text-warning">
                        <i class="fa fa-user-shield fs-2"></i>
                    </div>
                </div>
                <div>
                    <h3 class="mb-1">Edit Role</h3>
                    <div class="text-muted fs-7">Kelola informasi role dan access control.</div>
                </div>
            </div>
        </div>
        <div class="card-toolbar">
            <a asp-action="Index" class="btn btn-light btn-sm">
                <i class="fa fa-arrow-left"></i> Back to Role List
            </a>
        </div>
    </div>
    <div class="card-body py-8">
        <div class="row">
            <!-- Left Side: Role Info -->
            <div class="col-md-4">
                <form id="form-role">
                    <input type="hidden" id="role-id" value="@Model.RoleId" />
                    <input type="hidden" id="role-type-value" value="@Model.RoleType" />
                    <div class="mb-3">
                        <label class="form-label required">Role Type</label>
                        <select class="form-select bg-light" id="role-type" required disabled>
                            @* Populated by roleTypeData in JS *@
                        </select>
                        <small class="text-muted">
                            <i class="fa fa-info-circle"></i> Role type cannot be changed when editing
                        </small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label required">Role Name</label>
                        <input type="text" class="form-control" id="role-name" value="@Model.RoleName" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" id="role-description" rows="3">@Model.Description</textarea>
                    </div>
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="role-active" checked="@Model.IsActive" />
                            <label class="form-check-label" for="role-active">Active</label>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Right Side: Access Control -->
            <div class="col-md-8">
                <h5 class="mb-4">Access Control</h5>

                <!-- Full Access -->
                <div class="mb-4">
                    <h6>Full Access</h6>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="select-all-permissions">
                        <label class="form-check-label" for="select-all-permissions">
                            Select All
                        </label>
                    </div>
                </div>

                <!-- Menu Permissions -->
                <div id="menu-permissions-container" style="max-height: 400px; overflow-y: auto;">
                    <!-- Will be populated by JavaScript -->
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end mt-6 pt-3 border-top">
            <a asp-action="Index" class="btn btn-secondary me-3">Cancel</a>
            <button type="button" class="btn btn-primary" id="btn-save-role">Save</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/custom/features/role/role-type-data.js"></script>
    <script src="~/custom/features/role/permissions.js"></script>
    <script src="~/custom/features/role/edit.js"></script>
}