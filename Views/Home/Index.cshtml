@model AccuFlow.Models.Home.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Breadcrumbs"] = new List<AccuFlow.Helpers.BreadcrumbHelper.BreadcrumbItem>
    {
        new AccuFlow.Helpers.BreadcrumbHelper.BreadcrumbItem { Title = "Home", Url = "/" },
        new AccuFlow.Helpers.BreadcrumbHelper.BreadcrumbItem { Title = "Dashboard", Url = "#" }
    };

    string Currency(decimal value) => string.Format(new System.Globalization.CultureInfo("id-ID"), "Rp {0:N0}", value);
    var completionRate = Model.DraftJournals + Model.PostedJournals == 0
        ? 0
        : (int)Math.Round((decimal)Model.PostedJournals / (Model.DraftJournals + Model.PostedJournals) * 100);
}

<style>
    .dashboard-canvas {
        --dash-ink: #17312f;
        --dash-muted: #6f817d;
        --dash-teal: #0f8f7f;
        --dash-teal-dark: #0c5f57;
        --dash-gold: #d99a2b;
        --dash-coral: #d96b4b;
        --dash-paper: #fffaf1;
        --dash-line: rgba(23, 49, 47, 0.11);
        display: flex;
        flex-direction: column;
        gap: 24px;
        color: var(--dash-ink);
    }

    .dashboard-hero {
        position: relative;
        overflow: hidden;
        display: grid;
        grid-template-columns: minmax(0, 1.4fr) minmax(280px, 0.6fr);
        gap: 24px;
        padding: clamp(24px, 4vw, 38px);
        border: 1px solid var(--dash-line);
        border-radius: 30px;
        background:
            radial-gradient(circle at 10% 18%, rgba(217, 154, 43, 0.28), transparent 32%),
            linear-gradient(135deg, #fff7e8 0%, #e9f5ee 58%, #f8eadc 100%);
        box-shadow: 0 24px 60px rgba(22, 50, 47, 0.1);
    }

    .dashboard-hero::after {
        content: "";
        position: absolute;
        right: -70px;
        top: -90px;
        width: 260px;
        height: 260px;
        border-radius: 999px;
        background: radial-gradient(circle, rgba(15, 143, 127, 0.22), transparent 68%);
    }

    .hero-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 8px 12px;
        margin-bottom: 18px;
        border: 1px solid rgba(15, 143, 127, 0.18);
        border-radius: 999px;
        color: var(--dash-teal-dark);
        background: rgba(255, 255, 255, 0.62);
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .hero-title {
        max-width: 760px;
        margin: 0;
        font-size: clamp(34px, 4.6vw, 58px);
        line-height: 0.98;
        letter-spacing: -0.06em;
        font-weight: 900;
    }

    .hero-copy {
        max-width: 650px;
        margin: 18px 0 0;
        color: var(--dash-muted);
        font-size: 15px;
        line-height: 1.75;
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 26px;
    }

    .dash-button {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 12px 16px;
        border-radius: 16px;
        font-weight: 800;
        text-decoration: none;
        transition: transform 180ms ease, box-shadow 180ms ease;
    }

    .dash-button:hover {
        transform: translateY(-2px);
    }

    .dash-button.primary {
        color: #fff;
        background: linear-gradient(135deg, var(--dash-teal-dark), var(--dash-teal));
        box-shadow: 0 16px 28px rgba(15, 143, 127, 0.24);
    }

    .dash-button.soft {
        color: var(--dash-teal-dark);
        border: 1px solid rgba(15, 143, 127, 0.18);
        background: rgba(255, 255, 255, 0.68);
    }

    .hero-score {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 250px;
        padding: 24px;
        border: 1px solid rgba(255, 255, 255, 0.7);
        border-radius: 26px;
        background: rgba(255, 255, 255, 0.64);
        backdrop-filter: blur(14px);
    }

    .score-ring {
        --score: 0deg;
        display: grid;
        place-items: center;
        width: 136px;
        height: 136px;
        margin-left: auto;
        border-radius: 50%;
        background: conic-gradient(var(--dash-teal) var(--score), rgba(15, 143, 127, 0.12) 0);
    }

    .score-ring span {
        display: grid;
        place-items: center;
        width: 104px;
        height: 104px;
        border-radius: 50%;
        background: var(--dash-paper);
        font-size: 28px;
        font-weight: 900;
    }

    .metric-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
    }

    .metric-card {
        position: relative;
        overflow: hidden;
        padding: 22px;
        border: 1px solid var(--dash-line);
        border-radius: 24px;
        background: #fff;
        box-shadow: 0 16px 40px rgba(22, 50, 47, 0.06);
    }

    .metric-card::after {
        content: "";
        position: absolute;
        right: -38px;
        bottom: -48px;
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background: rgba(217, 154, 43, 0.14);
    }

    .metric-icon {
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        margin-bottom: 18px;
        border-radius: 16px;
        color: var(--dash-teal-dark);
        background: rgba(15, 143, 127, 0.1);
    }

    .metric-value {
        position: relative;
        z-index: 1;
        margin: 0;
        font-size: 24px;
        font-weight: 900;
        letter-spacing: -0.04em;
    }

    .metric-label {
        position: relative;
        z-index: 1;
        margin: 6px 0 0;
        color: var(--dash-muted);
        font-size: 13px;
        font-weight: 700;
    }

    .dashboard-main-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.9fr);
        gap: 20px;
    }

    .dash-panel {
        padding: 24px;
        border: 1px solid var(--dash-line);
        border-radius: 26px;
        background: #fff;
        box-shadow: 0 16px 40px rgba(22, 50, 47, 0.06);
    }

    .panel-header {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 18px;
    }

    .panel-header h3 {
        margin: 0;
        font-size: 20px;
        font-weight: 900;
    }

    .quick-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    .quick-tile {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 18px;
        min-height: 116px;
        border: 1px solid rgba(23, 49, 47, 0.1);
        border-radius: 20px;
        color: var(--dash-ink);
        background: linear-gradient(135deg, rgba(248, 242, 232, 0.9), rgba(255, 255, 255, 0.9));
        text-decoration: none;
        transition: transform 180ms ease, border-color 180ms ease;
    }

    .quick-tile:hover {
        color: var(--dash-ink);
        border-color: rgba(15, 143, 127, 0.32);
        transform: translateY(-3px);
    }

    .quick-tile i {
        display: grid;
        place-items: center;
        flex: 0 0 42px;
        height: 42px;
        border-radius: 14px;
        color: #fff;
        background: var(--dash-teal);
    }

    .quick-tile strong {
        display: block;
        margin-bottom: 5px;
        font-weight: 900;
    }

    .quick-tile span {
        color: var(--dash-muted);
        font-size: 12px;
        line-height: 1.55;
    }

    .activity-list {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .activity-item {
        display: grid;
        grid-template-columns: 42px minmax(0, 1fr);
        gap: 14px;
        align-items: start;
        padding-bottom: 14px;
        border-bottom: 1px dashed rgba(23, 49, 47, 0.14);
    }

    .activity-item:last-child {
        border-bottom: 0;
        padding-bottom: 0;
    }

    .activity-badge {
        display: grid;
        place-items: center;
        width: 42px;
        height: 42px;
        border-radius: 14px;
        color: var(--dash-gold);
        background: rgba(217, 154, 43, 0.12);
        font-weight: 900;
    }

    .activity-item strong {
        display: block;
        font-weight: 900;
    }

    .activity-item p {
        margin: 4px 0;
        color: var(--dash-muted);
        font-size: 12px;
    }

    .activity-item small {
        color: var(--dash-muted);
        font-weight: 700;
    }

    @@media (max-width: 1200px) {
        .metric-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 992px) {
        .dashboard-hero,
        .dashboard-main-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 640px) {
        .metric-grid,
        .quick-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="dashboard-canvas">
    <section class="dashboard-hero">
        <div>
            <div class="hero-eyebrow"><i class="fa fa-chart-line"></i> Finance command center</div>
            <h1 class="hero-title">Selamat datang, @Model.FullName</h1>
            <p class="hero-copy">
                Pantau arus invoice, jurnal, kas, dan aktivitas operasional dari satu dashboard yang lebih jelas.
                Anda login sebagai <strong>@Model.RoleName</strong>.
            </p>
            <div class="hero-actions">
                <a class="dash-button primary" href="@Url.Action("Index", "JournalEntry")"><i class="fa fa-plus-circle"></i> New Journal</a>
                <a class="dash-button soft" href="@Url.Action("Index", "Invoice")"><i class="fa fa-file-invoice"></i> Open Invoices</a>
                <a class="dash-button soft" href="@Url.Action("Index", "GeneralLedger")"><i class="fa fa-book"></i> Ledger</a>
            </div>
        </div>
        <aside class="hero-score">
            <div>
                <div class="text-muted fw-bold mb-2">Journal posting health</div>
                <div class="score-ring" style="--score:@(completionRate * 3.6)deg"><span>@completionRate%</span></div>
            </div>
            <div class="mt-4">
                <div class="fw-bold">@Model.PostedJournals posted / @Model.DraftJournals draft</div>
                <div class="text-muted fs-7">Keep draft journals reviewed and posted.</div>
            </div>
        </aside>
    </section>

    <section class="metric-grid">
        <article class="metric-card">
            <div class="metric-icon"><i class="fa fa-wallet"></i></div>
            <h2 class="metric-value">@Currency(Model.Receivables)</h2>
            <p class="metric-label">Outstanding receivables</p>
        </article>
        <article class="metric-card">
            <div class="metric-icon"><i class="fa fa-receipt"></i></div>
            <h2 class="metric-value">@Currency(Model.Payables)</h2>
            <p class="metric-label">Outstanding payables</p>
        </article>
        <article class="metric-card">
            <div class="metric-icon"><i class="fa fa-calendar-times"></i></div>
            <h2 class="metric-value">@Model.OverdueInvoices</h2>
            <p class="metric-label">Overdue invoices from @Model.OpenInvoices open</p>
        </article>
        <article class="metric-card">
            <div class="metric-icon"><i class="fa fa-money-bill-wave"></i></div>
            <h2 class="metric-value">@Currency(Model.CashMovementsThisMonth)</h2>
            <p class="metric-label">Cash movement this month</p>
        </article>
    </section>

    <section class="dashboard-main-grid">
        <div class="dash-panel">
            <div class="panel-header">
                <div>
                    <h3>Quick Actions</h3>
                    <div class="text-muted fs-7">Shortcut untuk pekerjaan harian.</div>
                </div>
            </div>
            <div class="quick-grid">
                <a class="quick-tile" href="@Url.Action("Index", "ChartOfAccount")">
                    <i class="fa fa-sitemap"></i>
                    <div><strong>Chart of Accounts</strong><span>Kelola struktur akun dan akun posting.</span></div>
                </a>
                <a class="quick-tile" href="@Url.Action("Index", "Invoice")">
                    <i class="fa fa-file-invoice-dollar"></i>
                    <div><strong>Invoices</strong><span>Buat dan pantau invoice penjualan maupun pembelian.</span></div>
                </a>
                <a class="quick-tile" href="@Url.Action("Index", "Payment")">
                    <i class="fa fa-credit-card"></i>
                    <div><strong>Payments</strong><span>Catat penerimaan, pembayaran, dan alokasi invoice.</span></div>
                </a>
                <a class="quick-tile" href="@Url.Action("Index", "PurchaseOrder")">
                    <i class="fa fa-truck-loading"></i>
                    <div><strong>Purchase Orders</strong><span>@Model.PendingPurchaseOrders dokumen masih perlu ditindaklanjuti.</span></div>
                </a>
                <a class="quick-tile" href="@Url.Action("Index", "User")">
                    <i class="fa fa-users-cog"></i>
                    <div><strong>User Access</strong><span>@Model.ActiveUsers users aktif dan @Model.ActiveRoles roles aktif.</span></div>
                </a>
                <a class="quick-tile" href="@Url.Action("Index", "TrialBalance")">
                    <i class="fa fa-balance-scale"></i>
                    <div><strong>Trial Balance</strong><span>Review keseimbangan debit dan kredit periode berjalan.</span></div>
                </a>
            </div>
        </div>

        <aside class="dash-panel">
            <div class="panel-header">
                <div>
                    <h3>Recent Activity</h3>
                    <div class="text-muted fs-7">Dokumen terakhir yang berubah.</div>
                </div>
            </div>
            <div class="activity-list">
                @if (Model.RecentActivities.Any())
                {
                    foreach (var item in Model.RecentActivities)
                    {
                        <div class="activity-item">
                            <div class="activity-badge">@item.Category.Substring(0, 1)</div>
                            <div>
                                <strong>@item.Title</strong>
                                <p>@item.Description</p>
                                <small>@item.Category - @item.Date.ToLocalTime().ToString("dd MMM yyyy HH:mm")</small>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-muted">Belum ada aktivitas. Mulai dengan membuat journal atau invoice baru.</div>
                }
            </div>
        </aside>
    </section>
</div>
