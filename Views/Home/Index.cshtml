@{
    ViewData["Title"] = "Dashboard";
    ViewData["Breadcrumbs"] = new List<AccuFlow.Helpers.BreadcrumbHelper.BreadcrumbItem>
    {
        new AccuFlow.Helpers.BreadcrumbHelper.BreadcrumbItem { Title = "Home", Url = "/" },
        new AccuFlow.Helpers.BreadcrumbHelper.BreadcrumbItem { Title = "Dashboard", Url = "#" }
    };
}

<div class="row g-5 g-xl-10 mb-5 mb-xl-10">
    <!--begin::Col-->
    <div class="col-md-6 col-lg-6 col-xl-6 col-xxl-3 mb-md-5 mb-xl-10">
        <div class="card card-flush h-md-50 mb-5 mb-xl-10">
            <div class="card-header pt-5">
                <div class="card-title d-flex flex-column">
                    <span class="fs-2hx fw-bold text-dark me-2 lh-1 ls-n2">Welcome to AccuFlow</span>
                    <span class="text-gray-400 pt-1 fw-semibold fs-6">Accounting System</span>
                </div>
            </div>
            <div class="card-body d-flex flex-column justify-content-end pe-0">
                <span class="fs-6 fw-bolder text-gray-800 d-block mb-2">Getting Started</span>
                <div class="symbol-group symbol-hover flex-nowrap">
                    <div class="d-flex flex-column">
                        <a href="@Url.Action("Index", "Seed")" class="btn btn-sm btn-primary mb-2">
                            <i class="ki-duotone ki-abstract-26 fs-3">
                                <span class="path1"></span>
                                <span class="path2"></span>
                            </i>
                            Database Seeding
                        </a>
                        <span class="text-muted fs-7">Initialize your database with sample data</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!--end::Col-->
    
    <!--begin::Col-->
    <div class="col-md-6 col-lg-6 col-xl-6 col-xxl-3 mb-md-5 mb-xl-10">
        <div class="card card-flush h-md-50 mb-xl-10">
            <div class="card-header pt-5">
                <div class="card-title d-flex flex-column">
                    <div class="d-flex align-items-center">
                        <span class="fs-2hx fw-bold text-dark me-2 lh-1 ls-n2">0</span>
                    </div>
                    <span class="text-gray-400 pt-1 fw-semibold fs-6">Total Users</span>
                </div>
            </div>
            <div class="card-body d-flex align-items-end pt-0">
                <div class="d-flex align-items-center flex-column mt-3 w-100">
                    <div class="d-flex justify-content-between fw-bold fs-6 text-gray-400 w-100 mt-auto mb-2">
                        <span>Active</span>
                        <span>0</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!--end::Col-->
</div>

<div class="row g-5 g-xl-10">
    <!--begin::Col-->
    <div class="col-xl-12 mb-5 mb-xl-10">
        <div class="card card-flush h-xl-100">
            <div class="card-header pt-7">
                <h3 class="card-title align-items-start flex-column">
                    <span class="card-label fw-bold text-dark">Quick Actions</span>
                    <span class="text-gray-400 mt-1 fw-semibold fs-6">Manage your accounting system</span>
                </h3>
            </div>
            <div class="card-body pt-6">
                <div class="row g-5">
                    <div class="col-md-4">
                        <div class="d-flex flex-stack">
                            <div class="symbol symbol-40px me-4">
                                <div class="symbol-label fs-2 fw-semibold bg-light-primary text-primary">
                                    <i class="ki-duotone ki-abstract-26 fs-1">
                                        <span class="path1"></span>
                                        <span class="path2"></span>
                                    </i>
                                </div>
                            </div>
                            <div class="d-flex align-items-center flex-row-fluid flex-wrap">
                                <div class="flex-grow-1 me-2">
                                    <a href="@Url.Action("Index", "Seed")" class="text-gray-800 text-hover-primary fs-6 fw-bold">Database Seeding</a>
                                    <span class="text-muted fw-semibold d-block fs-7">Initialize database with data</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-4">
                        <div class="d-flex flex-stack">
                            <div class="symbol symbol-40px me-4">
                                <div class="symbol-label fs-2 fw-semibold bg-light-warning text-warning">
                                    <i class="ki-duotone ki-user fs-1">
                                        <span class="path1"></span>
                                        <span class="path2"></span>
                                    </i>
                                </div>
                            </div>
                            <div class="d-flex align-items-center flex-row-fluid flex-wrap">
                                <div class="flex-grow-1 me-2">
                                    <a href="@Url.Action("Index", "User")" class="text-gray-800 text-hover-primary fs-6 fw-bold">User Management</a>
                                    <span class="text-muted fw-semibold d-block fs-7">Manage users and roles</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-4">
                        <div class="d-flex flex-stack">
                            <div class="symbol symbol-40px me-4">
                                <div class="symbol-label fs-2 fw-semibold bg-light-success text-success">
                                    <i class="ki-duotone ki-chart-simple fs-1">
                                        <span class="path1"></span>
                                        <span class="path2"></span>
                                        <span class="path3"></span>
                                        <span class="path4"></span>
                                    </i>
                                </div>
                            </div>
                            <div class="d-flex align-items-center flex-row-fluid flex-wrap">
                                <div class="flex-grow-1 me-2">
                                    <a href="#" class="text-gray-800 text-hover-primary fs-6 fw-bold">Reports</a>
                                    <span class="text-muted fw-semibold d-block fs-7">View financial reports</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-4">
                        <div class="d-flex flex-stack">
                            <div class="symbol symbol-40px me-4">
                                <div class="symbol-label fs-2 fw-semibold bg-light-info text-info">
                                    <i class="ki-duotone ki-setting-2 fs-1">
                                        <span class="path1"></span>
                                        <span class="path2"></span>
                                    </i>
                                </div>
                            </div>
                            <div class="d-flex align-items-center flex-row-fluid flex-wrap">
                                <div class="flex-grow-1 me-2">
                                    <a href="#" class="text-gray-800 text-hover-primary fs-6 fw-bold">Settings</a>
                                    <span class="text-muted fw-semibold d-block fs-7">Configure system settings</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!--end::Col-->
</div>
