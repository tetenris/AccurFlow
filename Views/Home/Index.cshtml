@model AccuFlow.Models.Home.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Breadcrumbs"] = new List<AccuFlow.Helpers.BreadcrumbHelper.BreadcrumbItem>
    {
        new AccuFlow.Helpers.BreadcrumbHelper.BreadcrumbItem { Title = "Home", Url = "/" },
        new AccuFlow.Helpers.BreadcrumbHelper.BreadcrumbItem { Title = "Dashboard", Url = "#" }
    };
}

<style>
    .base-dashboard {
        --base-ink: #1d2f2b;
        --base-muted: #71817c;
        --base-green: #147a6c;
        --base-sand: #f7efe2;
        --base-line: rgba(29, 47, 43, 0.12);
        display: grid;
        gap: 22px;
        color: var(--base-ink);
    }

    .base-hero {
        position: relative;
        overflow: hidden;
        padding: clamp(26px, 4vw, 44px);
        border: 1px solid var(--base-line);
        border-radius: 30px;
        background:
            radial-gradient(circle at 88% 10%, rgba(20, 122, 108, 0.18), transparent 28%),
            linear-gradient(135deg, #fffaf1 0%, #edf7f2 58%, #f8eadc 100%);
        box-shadow: 0 24px 60px rgba(28, 55, 50, 0.08);
    }

    .base-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 8px 12px;
        margin-bottom: 18px;
        border: 1px solid rgba(20, 122, 108, 0.18);
        border-radius: 999px;
        color: var(--base-green);
        background: rgba(255, 255, 255, 0.65);
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .base-title {
        max-width: 780px;
        margin: 0;
        font-size: clamp(34px, 4.6vw, 58px);
        line-height: 1;
        letter-spacing: -0.05em;
        font-weight: 900;
    }

    .base-copy {
        max-width: 680px;
        margin: 18px 0 0;
        color: var(--base-muted);
        font-size: 15px;
        line-height: 1.75;
    }

    .base-card-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
    }

    .base-card {
        padding: 22px;
        border: 1px solid var(--base-line);
        border-radius: 24px;
        background: #fff;
        box-shadow: 0 16px 40px rgba(28, 55, 50, 0.06);
    }

    .base-card i {
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        margin-bottom: 18px;
        border-radius: 16px;
        color: #fff;
        background: var(--base-green);
    }

    .base-card h3 {
        margin: 0 0 8px;
        font-size: 18px;
        font-weight: 900;
    }

    .base-card p {
        margin: 0;
        color: var(--base-muted);
        line-height: 1.65;
    }

    @@media (max-width: 900px) {
        .base-card-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="base-dashboard">
    <section class="base-hero">
        <div class="base-eyebrow"><i class="fa fa-layer-group"></i> Base application shell</div>
        <h1 class="base-title">Selamat datang, @Model.FullName</h1>
        <p class="base-copy">
            Dashboard ini disiapkan kosong sebagai starter project. Anda login sebagai
            <strong>@Model.RoleName</strong>. Tambahkan widget, ringkasan, dan shortcut sesuai kebutuhan aplikasi baru.
        </p>
    </section>

    <section class="base-card-grid">
        <article class="base-card">
            <i class="fa fa-users-cog"></i>
            <h3>User Management</h3>
            <p>Kelola user, status active/inactive, lock password, dan reset default melalui menu Users.</p>
        </article>
        <article class="base-card">
            <i class="fa fa-user-shield"></i>
            <h3>Role & Permission</h3>
            <p>Atur role dan akses menu sebagai fondasi otorisasi aplikasi.</p>
        </article>
        <article class="base-card">
            <i class="fa fa-key"></i>
            <h3>Password Policy</h3>
            <p>Password expiry 30 hari, wajib ganti password awal, dan lock setelah 3 kali gagal login sudah aktif.</p>
        </article>
    </section>
</div>
