@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    Layout = null;
}

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>403 – Access Denied</title>
    <meta name="color-scheme" content="light dark">
    <style>
        :root{
          --bg1:#0f172a;/* slate-900 */
          --bg2:#111827cc;/* gray-900/80 */
          --card:#0b1220cc;/* slate-950/80 */
          --text:#e5e7eb;/* gray-200 */
          --muted:#9ca3af;/* gray-400 */
          --accent:#60a5fa;/* blue-400 */
          --accent-strong:#3b82f6;/* blue-500 */
          --ring:#93c5fd;/* blue-300 */
          --shadow: 0 10px 30px rgba(0,0,0,.35);
        }

        @("media (prefers-color-scheme: light)")
        {
          :root{
            --bg1:#eef2ff;/* indigo-50 */
            --bg2:#e0e7ff;/* indigo-100 */
            --card:#ffffffcc;
            --text:#0f172a;/* slate-900 */
            --muted:#475569;/* slate-600 */
            --accent:#2563eb;/* blue-600 */
            --accent-strong:#1d4ed8;/* blue-700 */
            --ring:#3b82f6;/* blue-500 */
            --shadow: 0 10px 30px rgba(2,6,23,.15);
          }
        }

        *{box-sizing:border-box}
        html,body{height:100%}
        body{
          margin:0;
          font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, "Apple Color Emoji", "Segoe UI Emoji";
          color:var(--text);
          background: radial-gradient(1200px 800px at 10% 10%, var(--bg2), transparent),
                      radial-gradient(1200px 800px at 90% 90%, var(--bg2), transparent),
                      linear-gradient(160deg, var(--bg1), var(--bg2));
          display:grid;
          place-items:center;
          padding:24px;
        }

        .card{
          width:min(680px, 92vw);
          background: var(--card);
          border: 1px solid rgba(255,255,255,.12);
          backdrop-filter: blur(10px);
          border-radius: 20px;
          box-shadow: var(--shadow);
          padding: clamp(20px, 4vw, 36px);
          position:relative;
          overflow: hidden;
          animation: floatIn .5s ease-out both;
        }

        @("keyframes floatIn"){
          from{transform: translateY(10px); opacity:0}
          to{transform: translateY(0); opacity:1}
        }

        .badge{
          position:absolute; inset:auto 16px 16px auto;
          font-weight:700; letter-spacing:.08em;
          font-size:.75rem; line-height:1;
          color:var(--accent-strong);
          background: rgba(99,102,241,.12);
          border:1px solid rgba(99,102,241,.25);
          padding:.5rem .6rem; border-radius:999px;
          user-select:none;
        }

        .icon{
          width: clamp(56px, 10vw, 84px);
          height: clamp(56px, 10vw, 84px);
          display:grid; place-items:center;
          border-radius: 18px;
          background: linear-gradient(135deg, rgba(59,130,246,.15), rgba(59,130,246,.35));
          border: 1px solid rgba(59,130,246,.35);
          margin-bottom: 16px;
        }
        .icon svg{ width: 56%; height:56% }

        h1{
          margin:0 0 8px 0;
          font-size: clamp(1.25rem, 2.2vw + .8rem, 2rem);
          line-height:1.2;
        }

        p{ margin:0; color:var(--muted); font-size: clamp(.95rem, 1.2vw + .4rem, 1.05rem) }
        .hint{ margin-top: 14px; font-size:.9rem }

        .actions{ display:flex; gap:12px; flex-wrap:wrap; margin-top:22px }
        .btn{
          appearance:none; border:none; cursor:pointer;
          border-radius: 14px; padding: 12px 16px; font-weight:600;
          background: var(--accent);
          color:white; text-decoration:none; display:inline-flex; gap:10px; align-items:center;
          transition: transform .06s ease, box-shadow .2s ease, background .2s ease;
          box-shadow: 0 6px 18px rgba(37,99,235,.35);
        }
        .btn:hover{ transform: translateY(-1px) }
        .btn:active{ transform: translateY(0) scale(.98) }

        .btn.secondary{
          background: transparent; color: var(--text);
          border:1px solid rgba(148,163,184,.35);
          box-shadow:none;
        }

        .footer{
          margin-top: 26px; font-size:.85rem; color:var(--muted);
        }

        /* Accessibility */
        .btn:focus-visible, a:focus-visible{
          outline: 3px solid var(--ring);
          outline-offset: 2px;
          border-radius: 14px;
        }
    </style>
</head>
<body>
    <main class="card" role="main" aria-labelledby="title">
        <div class="badge" aria-hidden="true">403</div>

        <div class="icon" aria-hidden="true">
            <!-- Lock icon -->
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M7 10V8a5 5 0 0 1 10 0v2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                <rect x="4.75" y="10" width="14.5" height="10.5" rx="2.5" stroke="currentColor" stroke-width="1.6" />
                <circle cx="12" cy="15.5" r="1.6" fill="currentColor" />
            </svg>
        </div>

        <h1 id="title">Error</h1>
        <p>Sorry, an error occurred while processing your request.</p>
        <p class="hint">Please try again or contact support if the problem persists.</p>
        
        <div class="actions">
            <a href="/" class="btn">Go to Homepage</a>
        </div>

    </main>
</body>
</html>

