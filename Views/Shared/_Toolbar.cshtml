@using AccuFlow.Helpers

@{
	var breadcrumbs = ViewData["Breadcrumbs"] as List<BreadcrumbHelper.BreadcrumbItem>;
}

<div id="kt_app_toolbar" class="app-toolbar ">
	<div id="kt_app_toolbar_container" class="app-container container-fluid d-flex flex-stack">
		<div class="page-title d-flex justify-content-center flex-wrap me-3">
			@if (!string.IsNullOrEmpty(ViewData["Back Detail"] as string))
			{
				<a href="@ViewData["Back Detail"]" class="btn btn-secondary btn-sm back-button"><i class="fa fa-arrow-left"></i></a>
			}
			else if (!string.IsNullOrEmpty(ViewData["Back"] as string))
			{
				<a asp-action="Index" class="btn btn-secondary btn-sm back-button"><i class="fa fa-arrow-left"></i></a>

			}
			<div class="d-flex flex-column">
				<h1 class="page-heading d-flex text-dark flex-column justify-content-center my-0 quicksand-bold">@ViewData["Title"]</h1>
				<ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0 pt-1">
					@if (breadcrumbs != null)
					{
						for (int i = 0; i < breadcrumbs.Count; i++)
						{
							var breadcrumb = breadcrumbs[i];
							var isLastItem = i == breadcrumbs.Count - 1;
							var itemClass = isLastItem ? "breadcrumb-item text-muted rubik-light active" : "breadcrumb-item text-muted rubik-light";

							if (!isLastItem)
							{
								<li class="@itemClass">
									<a href="@breadcrumb.Url" class="text-muted text-hover-primary">@breadcrumb.Title</a>
								</li>
								<li class="breadcrumb-item rubik-light">></li>
							}
							else
							{
								<li class="@itemClass">@breadcrumb.Title</li>
							}
						}
					}
				</ul>
			</div>
		</div>

		<div class="d-flex align-items-center gap-2 gap-lg-3" id="toolbar-section-button">
		</div>
	</div>

</div>
